/**
  * @brief  Examine a given SRC PDO to check if matching with SNK capabilities.
  * @param  port_num The current port number.
  * @param  src_pdo Selected SRC PDO (32 bits)
  * @param  p_requested_voltage Pointer on Voltage value that could be reached if SRC PDO is
  *                             requested (only valid if USBPD_TRUE is returned) in mV
  * @param  p_requested_pwr Pointer on Power value that could be reached if SRC PDO is requested
  *                         (only valid if USBPD_TRUE is returned) in mW
  * @retval USBPD_FALSE of USBPD_TRUE (USBPD_TRUE returned in SRC PDO is considered matching with SNK profile)
  */
uint32_t USBPD_DPM_SNK_EvaluateMatchWithSRCPDO(uint8_t port_num, uint32_t src_pdo, uint32_t *p_requested_voltage,
                                               uint32_t *p_requested_pwr)
{
  usbpd_pdo_t srcpdo;
  usbpd_pdo_t snkpdo;
  uint32_t match = USBPD_FALSE;
  uint32_t nbsnkpdo;
  uint32_t snkpdo_array[USBPD_MAX_NB_PDO];
  uint32_t i;
  uint32_t srcvoltage50mv;
  uint32_t srcmaxvoltage50mv;
  uint32_t srcminvoltage50mv;
  uint32_t srcmaxcurrent10ma;
  uint32_t snkvoltage50mv;
  uint32_t snkmaxvoltage50mv;
  uint32_t snkminvoltage50mv;
  uint32_t snkopcurrent10ma;
  uint32_t maxrequestedpower;
  uint32_t currentrequestedpower;
  uint32_t maxrequestedvoltage;
  uint32_t currentrequestedvoltage;
  uint32_t snkoppower250mw;
  uint32_t srcmaxpower250mw;

  /* Retrieve SNK PDO list from PWR storage: PDO values + nb of u32 written by PWR (nb of PDOs) */
  USBPD_PWR_GetPortPDOs(port_num, USBPD_CORE_DATAINFO_DATATYPE_SNK_PDO, (uint8_t *)snkpdo_array, &nbsnkpdo);
  if (0U == nbsnkpdo)
  {
    return (USBPD_FALSE);
  }
  /* Set default output values */
  maxrequestedpower    = 0U;
  maxrequestedvoltage  = 0U;
  /* Check SRC PDO value according to its type */
  srcpdo.d32 = src_pdo;
  switch ((usbpd_core_pdo_type_t)srcpdo.pdo_generic.pdo_type)
  {
    /* SRC Fixed Supply PDO */
    case USBPD_CORE_PDO_TYPE_FIXED:
      srcvoltage50mv = srcpdo.pdo_src_fixed.voltage_50mv_units;
      srcmaxcurrent10ma = srcpdo.pdo_src_fixed.current_max_10ma_units;
      /* Loop through SNK PDO list */
      for (i = 0U; i < nbsnkpdo; i++)
      {
        currentrequestedpower = 0U;
        currentrequestedvoltage = 0U;

        /* Retrieve SNK PDO value according to its type */
        snkpdo.d32 = snkpdo_array[i];
        switch ((usbpd_core_pdo_type_t)snkpdo.pdo_generic.pdo_type)
        {
          /* SNK Fixed Supply PDO */
          case USBPD_CORE_PDO_TYPE_FIXED:
          {
            snkvoltage50mv = snkpdo.pdo_snk_fixed.voltage_50mv_units;
            snkopcurrent10ma = snkpdo.pdo_snk_fixed.operational_current_10ma_units;
            /* Match if:
                 SNK Voltage = SRC Voltage
                 and
                 SNK Op Current <= SRC Max Current
               Requested Voltage: SNK Voltage
               Requested Op Current: SNK Op Current
               Requested Max Current: SNK Op Current
            */
            if ((snkvoltage50mv == srcvoltage50mv)
                && (snkopcurrent10ma <= srcmaxcurrent10ma))
            {
              currentrequestedpower = (snkvoltage50mv * snkopcurrent10ma) / 2U; /* to get value in mw */
              currentrequestedvoltage = snkvoltage50mv;
            }
            break;
          }
          /* SNK Variable Supply (non-battery) PDO */
          case USBPD_CORE_PDO_TYPE_VARIABLE:
            snkmaxvoltage50mv = snkpdo.pdo_snk_variable.voltage_max_50mv_units;
            snkminvoltage50mv = snkpdo.pdo_snk_variable.voltage_min_50mv_units;
            snkopcurrent10ma  = snkpdo.pdo_snk_variable.operational_current_10ma_units;
            /* Match if:
                 SNK Max voltage >= SRC Voltage
                 and
                 SNK Min voltage <= SRC Voltage
                 and
                 SNK Op current <= SRC Max current
               Requested Voltage: SRC Voltage
               Requested Op Current: SNK Op Current
               Requested Max Current: SNK Op Current
            */
            if ((snkmaxvoltage50mv >= srcvoltage50mv)
                && (snkminvoltage50mv <= srcvoltage50mv)
                && (snkopcurrent10ma  <= srcmaxcurrent10ma))
            {
              currentrequestedpower = (srcvoltage50mv * snkopcurrent10ma) / 2U; /* to get value in mw */
              currentrequestedvoltage = srcvoltage50mv;
            }
            break;
          /* SNK Battery Supply PDO */
          case USBPD_CORE_PDO_TYPE_BATTERY:
            snkmaxvoltage50mv = snkpdo.pdo_snk_battery.voltage_max_50mv_units;
            snkminvoltage50mv = snkpdo.pdo_snk_battery.voltage_min_50mv_units;
            snkoppower250mw   = snkpdo.pdo_snk_battery.operational_pwr_250mw_units;
            /* Match if:
                 SNK Max voltage >= SRC Voltage
                 and
                 SNK Min voltage <= SRC Voltage
                 and
                 SNK Op power <= SRC Max current * SRC Voltage
               Requested Voltage: SRC Voltage
               Requested Op Current: SNK Op Power/ SRC Voltage
               Requested Max Current: SNK Op Power/ SRC Voltage
            */
            if ((snkmaxvoltage50mv >= srcvoltage50mv)
                && (snkminvoltage50mv <= srcvoltage50mv)
                && (snkoppower250mw <= ((srcvoltage50mv * srcmaxcurrent10ma) / 500U)))
              /* to get value in 250 mw units */
            {
              currentrequestedvoltage = srcvoltage50mv;
              currentrequestedpower = snkoppower250mw;
            }
            break;
          /* SNK Augmented Power Data Object (APDO) */
          case USBPD_CORE_PDO_TYPE_APDO:
            break;
          default:
            break;
        }
        if (currentrequestedpower > maxrequestedpower)
        {
          match = USBPD_TRUE;
          maxrequestedpower   = currentrequestedpower;
          maxrequestedvoltage = currentrequestedvoltage;
        }
      }
      break;
    /* SRC Variable Supply (non-battery) PDO */
    case USBPD_CORE_PDO_TYPE_VARIABLE:
      srcmaxvoltage50mv = srcpdo.pdo_src_variable.voltage_max_50mv_units;
      srcminvoltage50mv = srcpdo.pdo_src_variable.voltage_min_50mv_units;
      srcmaxcurrent10ma = srcpdo.pdo_src_variable.current_max_10ma_units;
      /* Loop through SNK PDO list */
      for (i = 0U; i < nbsnkpdo; i++)
      {
        currentrequestedpower = 0U;
        currentrequestedvoltage = 0U;
        /* Retrieve SNK PDO value according to its type */
        snkpdo.d32 = snkpdo_array[i];
        switch ((usbpd_core_pdo_type_t)snkpdo.pdo_generic.pdo_type)
        {
          /* SNK Fixed Supply PDO */
          case USBPD_CORE_PDO_TYPE_FIXED:
            /* No match */
            break;
          /* SNK Variable Supply (non-battery) PDO */
          case USBPD_CORE_PDO_TYPE_VARIABLE:
            snkmaxvoltage50mv = snkpdo.pdo_snk_variable.voltage_max_50mv_units;
            snkminvoltage50mv = snkpdo.pdo_snk_variable.voltage_min_50mv_units;
            snkopcurrent10ma  = snkpdo.pdo_snk_variable.operational_current_10ma_units;
            /* Match if:
                 SNK Max voltage >= SRC Max Voltage
                 and
                 SNK Min voltage <= SRC Min Voltage
                 and
                 SNK Op current <= SRC Max current
               Requested Voltage: Any value between SRC Min Voltage and SRC Max Voltage
               Requested Op Current: SNK Op Current
               Requested Max Current: SNK Op Current
            */
            if ((snkmaxvoltage50mv >= srcmaxvoltage50mv)
                && (snkminvoltage50mv <= srcminvoltage50mv)
                && (snkopcurrent10ma <= srcmaxcurrent10ma))
            {
              currentrequestedpower = (srcmaxvoltage50mv * snkopcurrent10ma) / 2U; /* to get value in mw */
              currentrequestedvoltage = srcmaxvoltage50mv;
            }
            break;
          /* SNK Battery Supply PDO */
          case USBPD_CORE_PDO_TYPE_BATTERY:
            snkmaxvoltage50mv = snkpdo.pdo_snk_battery.voltage_max_50mv_units;
            snkminvoltage50mv = snkpdo.pdo_snk_battery.voltage_min_50mv_units;
            snkoppower250mw   = snkpdo.pdo_snk_battery.operational_pwr_250mw_units;
            /* Match if:
                 SNK Max voltage >= SRC Max Voltage
                 and
                 SNK Min voltage <= SRC Min Voltage
                 and
                 SNK Op power <= SRC Max current * SRC Max Voltage
               Requested Voltage: Any value between SRC Min Voltage and SRC Max Voltage, that fulfill
                                   SNK Op power <= Voltage * SRC Max Current
               Requested Op Current: SNK Op Power/ SRC Voltage
               Requested Max Current: SNK Op Power/ SRC Voltage
            */
            if ((snkmaxvoltage50mv >= srcmaxvoltage50mv)
                && (snkminvoltage50mv <= srcminvoltage50mv)
                && (snkoppower250mw <= ((srcmaxvoltage50mv *
                                         srcmaxcurrent10ma) / 500U))) /* to get value in 250 mw units */
            {
              currentrequestedpower   = snkoppower250mw * 250U; /* to get value in mw */
              currentrequestedvoltage = srcmaxvoltage50mv;
            }
            break;
          /* SNK Augmented Power Data Object (APDO) */
          case USBPD_CORE_PDO_TYPE_APDO:
            break;
          default:
            break;
        }
        if (currentrequestedpower > maxrequestedpower)
        {
          match = USBPD_TRUE;
          maxrequestedpower   = currentrequestedpower;
          maxrequestedvoltage = currentrequestedvoltage;
        }
      }
      break;
    /* SRC Battery Supply PDO */
    case USBPD_CORE_PDO_TYPE_BATTERY:
      srcmaxvoltage50mv = srcpdo.pdo_src_battery.voltage_max_50mv_units;
      srcminvoltage50mv = srcpdo.pdo_src_battery.voltage_min_50mv_units;
      srcmaxpower250mw  = srcpdo.pdo_src_battery.allowable_pwr_max_250mw_units;
      /* Loop through SNK PDO list */
      for (i = 0U; i < nbsnkpdo; i++)
      {
        currentrequestedpower = 0U;
        currentrequestedvoltage = 0U;
        /* Retrieve SNK PDO value according to its type */
        snkpdo.d32 = snkpdo_array[i];
        switch ((usbpd_core_pdo_type_t)snkpdo.pdo_generic.pdo_type)
        {
          /* SNK Fixed Supply PDO */
          case USBPD_CORE_PDO_TYPE_FIXED:
            /* No match */
            break;
          /* SNK Variable Supply (non-battery) PDO */
          case USBPD_CORE_PDO_TYPE_VARIABLE:
            snkmaxvoltage50mv = snkpdo.pdo_snk_variable.voltage_max_50mv_units;
            snkminvoltage50mv = snkpdo.pdo_snk_variable.voltage_min_50mv_units;
            snkopcurrent10ma  = snkpdo.pdo_snk_variable.operational_current_10ma_units;
            /* Match if:
                 SNK Max voltage >= SRC Max Voltage
                 and
                 SNK Min voltage <= SRC Min Voltage
                 and
                 SNK Op current * SRC Max Voltage <= SRC Max Power
               Requested Voltage: Any value between SRC Min Voltage and SRC Max Voltage: SRC Max Voltage
               Requested Op Current: SNK Op Current
               Requested Max Current: SNK Op Current
            */
            if ((snkmaxvoltage50mv >= srcmaxvoltage50mv)
                && (snkminvoltage50mv <= srcminvoltage50mv)
                && (srcmaxvoltage50mv * snkopcurrent10ma <= srcmaxpower250mw))
            {
              currentrequestedpower = (srcmaxvoltage50mv * snkopcurrent10ma) / 2U; /* to get value in mw */
              currentrequestedvoltage = srcmaxvoltage50mv;
            }
            break;
          /* SNK Battery Supply PDO */
          case USBPD_CORE_PDO_TYPE_BATTERY:
            snkmaxvoltage50mv = snkpdo.pdo_snk_battery.voltage_max_50mv_units;
            snkminvoltage50mv = snkpdo.pdo_snk_battery.voltage_min_50mv_units;
            snkoppower250mw   = snkpdo.pdo_snk_battery.operational_pwr_250mw_units;
            /* Match if:
                 SNK Max voltage >= SRC Max Voltage
                 and
                 SNK Min voltage <= SRC Min Voltage
                 and
                 SNK Op power <= SRC Max power
               Requested Voltage: Any value between SRC Min Voltage and SRC Max Voltage, that fulfill
                                   SNK Op power <= Voltage * SRC Max Current
               Requested Op Current: SNK Op Power/ SRC Voltage
               Requested Max Current: SNK Op Power/ SRC Voltage
            */
            if ((snkmaxvoltage50mv >= srcmaxvoltage50mv)
                && (snkminvoltage50mv <= srcminvoltage50mv)
                && (snkoppower250mw <= srcmaxpower250mw))
            {
              currentrequestedpower   = snkoppower250mw * 250U; /* to get value in mw */
              currentrequestedvoltage = srcmaxvoltage50mv;
            }
            break;
          /* SNK Augmented Power Data Object (APDO) */
          case USBPD_CORE_PDO_TYPE_APDO:
            break;
          default:
            break;
        }
        if (currentrequestedpower > maxrequestedpower)
        {
          match = USBPD_TRUE;
          maxrequestedpower   = currentrequestedpower;
          maxrequestedvoltage = currentrequestedvoltage;
        }
      }
      break;
    /* Augmented Power Data Object (APDO) */
    case USBPD_CORE_PDO_TYPE_APDO:
    {
    if(srcpdo.pdo_src_snk_apdo.programmable_pwr_supply == USBPD_CORE_APDO_TYPE_PPS)
    {
      uint32_t srcmaxvoltage100mv;
      uint32_t srcmaxcurrent50ma;
      srcmaxvoltage100mv = srcpdo.pdo_src_snk_apdo.voltage_max_100mv_units;
      srcmaxcurrent50ma = srcpdo.pdo_src_snk_apdo.current_max_50ma_units;
      /* Loop through SNK PDO list */
      for (i = 0U; i < nbsnkpdo; i++)
      {
        currentrequestedpower = 0U;
        currentrequestedvoltage = 0U;
        /* Retrieve SNK PDO value according to its type */
        snkpdo.d32 = snkpdo_array[i];
        switch ((usbpd_core_pdo_type_t)snkpdo.pdo_generic.pdo_type)
        {
          case USBPD_CORE_PDO_TYPE_FIXED:
          case USBPD_CORE_PDO_TYPE_VARIABLE:
          case USBPD_CORE_PDO_TYPE_BATTERY:
            /* No match */
            break;
          /* SNK Augmented Power Data Object (APDO) */
          case USBPD_CORE_PDO_TYPE_APDO:
          {
            uint32_t snkmaxvoltage100mv;
            uint32_t snkminvoltage100mv;
            uint32_t snkmaxcurrent50ma;
            snkminvoltage100mv = snkpdo.pdo_src_snk_apdo.voltage_min_100mv_units;
            snkmaxvoltage100mv = snkpdo.pdo_src_snk_apdo.voltage_max_100mv_units;
            snkmaxcurrent50ma = snkpdo.pdo_src_snk_apdo.current_max_50ma_units;
            /* Match if voltage matches with the APDO voltage range */
            if ((USBPD_PWR_DECODE_100MV(snkminvoltage100mv) <= (*p_requested_voltage))
                && ((*p_requested_voltage) <= USBPD_PWR_DECODE_100MV(snkmaxvoltage100mv))
                && (snkmaxcurrent50ma <= srcmaxcurrent50ma))
            {
              if (0U != *p_requested_pwr)
              {
                currentrequestedpower = (*p_requested_voltage *
                                         USBPD_PWR_DECODE_50MA(snkmaxcurrent50ma)) / 1000U; /* to get value in mw */
                currentrequestedvoltage = (*p_requested_voltage / 50U);
              }
              else
              {
                *p_requested_voltage = MIN(USBPD_PWR_DECODE_100MV(srcmaxvoltage100mv),
                                           USBPD_PWR_DECODE_100MV(snkmaxvoltage100mv));
                currentrequestedpower = (*p_requested_voltage *
                                         USBPD_PWR_DECODE_50MA(snkmaxcurrent50ma)) / 1000U; /* to get value in mw */
                currentrequestedvoltage = (*p_requested_voltage / 50U);
              }
            }
          }
          break;
          default:
            break;
        }
        if (currentrequestedpower > maxrequestedpower)
        {
          match = USBPD_TRUE;
          maxrequestedpower   = currentrequestedpower;
          maxrequestedvoltage = currentrequestedvoltage;
        }
      }
    }
    if(srcpdo.pdo_src_spr_avs.spr_adjustable_voltage == USBPD_CORE_APDO_TYPE_SPR_AVS)
    {
      uint16_t srcmaxcurrent15v10ma, srcmaxcurrent20v10ma;
      srcmaxcurrent15v10ma = srcpdo.pdo_src_spr_avs.current_max_15v_10mA_units;
      srcmaxcurrent20v10ma = srcpdo.pdo_src_spr_avs.current_max_20v_10mA_units;
      /* Loop through SNK PDO list */
      for (uint16_t i=0; i<nbsnkpdo; i++)
      {
        currentrequestedpower = 0;
        currentrequestedvoltage = 0;
        /* Retrieve SNK PDO value according to its type */
        snkpdo.d32 = snkpdo_array[i];
        switch((usbpd_core_pdo_type_t)snkpdo.pdo_generic.pdo_type)
        {
        case USBPD_CORE_PDO_TYPE_FIXED:
          {
            uint16_t min9v50mv, max15v50mv, max20v50mv;
            snkvoltage50mv = snkpdo.pdo_snk_fixed.voltage_50mv_units;
            snkopcurrent10ma = snkpdo.pdo_snk_fixed.operational_current_10ma_units;
            min9v50mv = USBPD_PWR_MV_50MV(9);
            max20v50mv = USBPD_PWR_MV_50MV(20);
            max15v50mv = USBPD_PWR_MV_50MV(15);
            if (srcmaxcurrent20v10ma != 0)
            {
              if ((snkopcurrent10ma <= srcmaxcurrent20v10ma)
                  && (snkopcurrent10ma <= srcmaxcurrent15v10ma)
                    && (min9v50mv <= snkvoltage50mv)
                      && (snkvoltage50mv <= max20v50mv))
              {
                currentrequestedpower = (15000 * 1500) / 1000; /* to get value in mw */ //*p_requested_pwr;
                currentrequestedvoltage =  (15000 / 50);
              }
            }
            else
            {
              if ((snkopcurrent10ma <= srcmaxcurrent15v10ma)
                  && (min9v50mv <= snkvoltage50mv)
                    && (snkvoltage50mv <= max15v50mv))
              {
                currentrequestedpower = (11200 * 1500) / 1000; /* to get value in mw */ //*p_requested_pwr;
                currentrequestedvoltage =  (11200 / 50);
              }
            }
          }
          break;
        case USBPD_CORE_PDO_TYPE_VARIABLE:
          break;
        case USBPD_CORE_PDO_TYPE_BATTERY:
          /* No match */
          break;
          /* SNK Augmented Power Data Object (APDO) */
        case USBPD_CORE_PDO_TYPE_APDO:
          {
            uint16_t snkmaxcurrent15v10ma, snkmaxcurrent20v10ma;
            snkmaxcurrent15v10ma = snkpdo.pdo_snk_spr_avs.current_max_15v_10mA_units;
            snkmaxcurrent20v10ma = snkpdo.pdo_snk_spr_avs.current_max_20v_10mA_units;
            if (srcmaxcurrent20v10ma != 0)
            {
              if ((snkmaxcurrent20v10ma <= srcmaxcurrent20v10ma)
                  && (snkmaxcurrent15v10ma <= srcmaxcurrent15v10ma))
              {
                currentrequestedpower = (16500 * USBPD_PWR_DECODE_10MA(snkmaxcurrent20v10ma)) / 1000; /* to get value in mw */
                currentrequestedvoltage = (16500 / 50);
              }
            }
            else
            {
              if (snkmaxcurrent15v10ma <= srcmaxcurrent15v10ma)
              {
                currentrequestedpower = (11200 * 1500) / 1000; /* to get value in mw */ //*p_requested_pwr;
                currentrequestedvoltage = (11200 / 50);
              }
            }
          }
          break;
        default:
          break;
        }
        if (currentrequestedpower > maxrequestedpower)
        {
          match = USBPD_TRUE;
          maxrequestedpower   = currentrequestedpower;
          maxrequestedvoltage = currentrequestedvoltage;
        }
      }
    }
    }
    break;
    default:
      return (USBPD_FALSE);
  }
  if (maxrequestedpower > 0U)
  {
    *p_requested_pwr   = maxrequestedpower;
    *p_requested_voltage = maxrequestedvoltage * 50U; /* value in mV */
  }
  return (match);
}

/**
  * @brief  Find PDO index that offers the most amount of power and in accordance with SNK capabilities.
  * @param  port_num The current port number.
  * @param  p_request_pwr_details Sink requested power details structure pointer
  * @param  sel_method Selection method
  * @retval Index of PDO within source capabilities message (DPM_NO_SRC_PDO_FOUND indicating not found)
  */
static uint32_t DPM_FindVoltageIndex(uint8_t port_num, usbpd_dpm_snk_pwr_request_details_t *p_request_pwr_details,
                                     usbpd_dpm_pdo_sel_method_t sel_method)
{
  const uint32_t *ptpdoarray;
  usbpd_pdo_t  pdo;
  uint32_t voltage;
  uint32_t reqvoltage;
  uint32_t nbpdo;
  uint32_t allowablepower;
  uint32_t selpower;
  uint32_t allowablecurrent;
  uint32_t selcurrent;
  uint32_t curr_index = DPM_NO_SRC_PDO_FOUND;
  uint32_t temp_index;
  usbpd_dpm_user_settings_t *puser = (usbpd_dpm_user_settings_t *)&usbpd_dpm_user_settings[port_num];
  usbpd_dpm_handle_t *h_dpm;
  h_dpm = USBPD_PWR_Get_DPM_Handler(port_num);

  if((puser == NULL) || (h_dpm == NULL))
  {
    return -1;
  }

  allowablepower = 0U;
  selpower       = 0U;
  reqvoltage     = 0U;
  voltage        = 0U;
  selcurrent     = 0U;

  /* Search PDO index among Source PDO of Port */
  nbpdo = h_dpm->rcv_src_pdo_count;
  ptpdoarray = h_dpm->p_list_rcv_src_pdo;

  /* search the best PDO in the list of source PDOs */
  for (temp_index = 0U; temp_index < nbpdo; temp_index++)
  {
    pdo.d32 = ptpdoarray[temp_index];

    /* Check if the received source PDO is matching any of the SNK PDO */
    allowablepower = 0U;
    if (USBPD_TRUE == USBPD_DPM_SNK_EvaluateMatchWithSRCPDO(port_num, pdo.d32, &voltage, &allowablepower))
    {
      allowablecurrent = (allowablepower / voltage) * 1000U;

      /* Choose the best PDO depending on the user preferences */
      switch (sel_method)
      {
        case USBPD_DPM_PDO_SEL_METHOD_MAX_PWR:
          if (allowablepower > selpower)
          {
            /* Consider the current PDO the best one until now */
            curr_index = temp_index;
            selpower   = allowablepower;
            reqvoltage = voltage;
            selcurrent = allowablecurrent;
          }
          break;

        case USBPD_DPM_PDO_SEL_METHOD_MIN_PWR:
          if ((allowablepower < selpower) || (selpower == 0U))
          {
            /* Consider the current PDO the best one until now */
            curr_index = temp_index;
            selpower   = allowablepower;
            reqvoltage = voltage;
            selcurrent = allowablecurrent;
          }
          break;

        case USBPD_DPM_PDO_SEL_METHOD_MAX_VOLT:
          if (voltage > reqvoltage)
          {
            /* Consider the current PDO the best one until now */
            curr_index = temp_index;
            selpower   = allowablepower;
            reqvoltage = voltage;
            selcurrent = allowablecurrent;
          }
          break;

        case USBPD_DPM_PDO_SEL_METHOD_MIN_VOLT:
          if ((voltage < reqvoltage) || (reqvoltage == 0U))
          {
            /* Consider the current PDO the best one until now */
            curr_index = temp_index;
            selpower   = allowablepower;
            reqvoltage = voltage;
            selcurrent = allowablecurrent;
          }
          break;

        case USBPD_DPM_PDO_SEL_METHOD_MAX_CUR:
          if (allowablecurrent > selcurrent)
          {
            /* Consider the current PDO the best one until now */
            curr_index = temp_index;
            selpower   = allowablepower;
            reqvoltage = voltage;
            selcurrent = allowablecurrent;
          }
          break;

        case USBPD_DPM_PDO_SEL_METHOD_MIN_CUR:
          if ((allowablecurrent < selcurrent) || (selcurrent == 0U))
          {
            /* Consider the current PDO the best one until now */
            curr_index = temp_index;
            selpower   = allowablepower;
            reqvoltage = voltage;
            selcurrent = allowablecurrent;
          }
          break;

        default:
          /* Default behavior: last PDO is selected */
          curr_index = temp_index;
          selpower   = allowablepower;
          reqvoltage = voltage;
          selcurrent = allowablecurrent;
          break;
      }
    }
  }

  /* If a suitable PDO was found */
  if (curr_index != DPM_NO_SRC_PDO_FOUND)
  {
    /* Fill the request power details */
    p_request_pwr_details->operating_current_max_1ma_units =
      puser->dpm_snk_requested_pwr.operating_current_max_1ma_units;
    p_request_pwr_details->operating_current_1ma_units     = (1000U * selpower) / reqvoltage;
    p_request_pwr_details->operating_pwr_max_1mw_units     = puser->dpm_snk_requested_pwr.operating_pwr_max_1mw_units;
    p_request_pwr_details->operating_pwr_1mw_units         = selpower;
    p_request_pwr_details->requested_voltage_1mv_units     = reqvoltage;
  }

  return curr_index;
}

/**
  * @brief  Build RDO to be used in Request message according to selected PDO from received SRC Capabilities.
  * @param  port_num The current port number.
  * @param  index_src_pdo Index on the selected SRC PDO (value between 0 to 6).
  * @param  p_request_pwr_details Sink requested power details structure pointer.
  * @param  rdo_out Pointer on the RDO.
  * @param  p_pwr_object Pointer on the selected power object.
  */
static void DPM_SNK_BuildRDOfromSelectedPDO(uint8_t port_num, uint8_t index_src_pdo,
                                            const usbpd_dpm_snk_pwr_request_details_t *p_request_pwr_details,
                                            usbpd_rdo_snk_t *rdo_out, usbpd_core_pdo_type_t *p_pwr_object)
{
  uint32_t mv;
  uint32_t mw;
  uint32_t ma;
  uint32_t size;
  usbpd_pdo_t pdo;
  usbpd_rdo_snk_t rdo;
  usbpd_dpm_handle_t *pdhandle = USBPD_PWR_Get_DPM_Handler(port_num);
  usbpd_dpm_user_settings_t *puser = (usbpd_dpm_user_settings_t *)&usbpd_dpm_user_settings[port_num];
  uint32_t snkpdolist[USBPD_MAX_NB_PDO];
  usbpd_pdo_t snk_fixed_pdo;
  usbpd_params_t *dpm_params;
  usbpd_settings_t *dpm_settings;

  dpm_params = USBPD_PE_Get_DPM_Params(port_num);
  dpm_settings = USBPD_PE_Get_DPM_Settings(port_num);

  if((dpm_params == NULL) || (dpm_settings == NULL) || (puser == NULL) || (pdhandle == NULL))
  {
    return;
  }

  /* Initialize RDO */
  rdo.d32 = 0U;
  /* Read SNK PDO list for retrieving useful data to fill in RDO */
  USBPD_PWR_GetPortPDOs(port_num, USBPD_CORE_DATAINFO_DATATYPE_SNK_PDO, (uint8_t *)&snkpdolist[0U], &size);
  /* Store value of 1st SNK PDO (Fixed) in local variable */
  snk_fixed_pdo.d32 = snkpdolist[0U];
  /* Set common fields in RDO */
  pdo.d32 = pdhandle->p_list_rcv_src_pdo[0U];
  rdo.rdo_generic.usb_com_capable     = snk_fixed_pdo.pdo_snk_fixed.usb_com_capable;
  if (USBPD_SPECIFICATION_REV2 < dpm_params->pe_spec_revision)
  {
    rdo.rdo_fixed_variable.unchunked_extended_message =
    dpm_settings->pe_pd3_support.b.pe_unchunk_support;
    dpm_params->pe_unchunk_support   = USBPD_FALSE;
    /* Set unchuncked bit if supported by port partner */
    if (USBPD_TRUE == pdo.pdo_src_fixed.unchunked_extended_message)
    {
      dpm_params->pe_unchunk_support   = USBPD_TRUE;
    }
  }
  /* If no valid SNK PDO or if no SRC PDO match found (index>=nb of valid received SRC PDOs */
  if ((size < 1U) || (index_src_pdo >= pdhandle->rcv_src_pdo_count))
  {
    /* USBPD_DPM_EvaluateCapabilities: Mismatch, could not find desired pdo index */
    USBPD_TRACE_WARNING_PRINTF(port_num, "%s: Issue with SRC PDO selection", __func__);
    rdo.rdo_fixed_variable.object_position            = 1U;
    rdo.rdo_fixed_variable.operating_current_10ma_units     = pdo.pdo_src_fixed.current_max_10ma_units;
    rdo.rdo_fixed_variable.operating_current_max_10ma_units = pdo.pdo_src_fixed.current_max_10ma_units;
    rdo.rdo_fixed_variable.capability_mismatch        = 1U;
    rdo.rdo_fixed_variable.usb_com_capable            = snk_fixed_pdo.pdo_snk_fixed.usb_com_capable;
    pdhandle->requested_current_1ma_units = puser->dpm_snk_requested_pwr.operating_current_max_1ma_units;
    /* USBPD_DPM_EvaluateCapabilities: Mismatch, could not find desired pdo index */
    pdhandle->rdo_msg = rdo.d32;
    return;
  }
  /* Set the Object position */
  rdo.rdo_generic.object_position = (uint32_t)index_src_pdo + 1U;
  rdo.rdo_generic.no_usb_suspend = (uint32_t)pdo.pdo_src_fixed.usb_suspend_supported;
  /* Extract power information from Power Data Object */
  pdo.d32 = pdhandle->p_list_rcv_src_pdo[index_src_pdo];
  *p_pwr_object = (usbpd_core_pdo_type_t)pdo.pdo_generic.pdo_type;
  /* Retrieve request details from SRC PDO selection */
  mv = p_request_pwr_details->requested_voltage_1mv_units;
  ma = p_request_pwr_details->operating_current_1ma_units;
  switch ((usbpd_core_pdo_type_t)pdo.pdo_generic.pdo_type)
  {
    case USBPD_CORE_PDO_TYPE_FIXED:
    case USBPD_CORE_PDO_TYPE_VARIABLE:
    {
      /* USBPD_DPM_EvaluateCapabilities: Mismatch, less power offered than the operating power */
      ma = USBPD_MIN(ma, puser->dpm_snk_requested_pwr.operating_current_max_1ma_units);
      mw = (ma * mv) / 1000U; /* mW */
      pdhandle->requested_current_1ma_units                   = ma;
      rdo.rdo_fixed_variable.operating_current_10ma_units     = ma / 10U;
      rdo.rdo_fixed_variable.operating_current_max_10ma_units = ma / 10U;
      if (mw < puser->dpm_snk_requested_pwr.operating_pwr_1mw_units)
      {
        /* USBPD_DPM_EvaluateCapabilities: Mismatch, less power offered than the operating power */
        rdo.rdo_fixed_variable.operating_current_max_10ma_units =
          puser->dpm_snk_requested_pwr.operating_current_max_1ma_units / 10U;
        rdo.rdo_fixed_variable.capability_mismatch = 1U;
      }
      break;
    }
    case USBPD_CORE_PDO_TYPE_BATTERY:
    {
      /* USBPD_DPM_EvaluateCapabilities: Battery Request Data Object */
      mw = USBPD_MIN(p_request_pwr_details->operating_pwr_1mw_units,
                     puser->dpm_snk_requested_pwr.operating_pwr_max_1mw_units); /* mW */
      if (mv != 0U)
      {
        ma = (1000U * mw) / mv; /* mA */
        ma = USBPD_MIN(ma, puser->dpm_snk_requested_pwr.operating_current_max_1ma_units);
        pdhandle->requested_current_1ma_units = ma;
        mw = (ma * mv) / 1000U; /* mW */
        rdo.rdo_battery.operating_pwr_250mw_units = mw / 250U;
        rdo.rdo_battery.operating_pwr_max_250mw_units = mw / 250U;
        if (mw < puser->dpm_snk_requested_pwr.operating_pwr_1mw_units)
        {
          /* Mismatch, less power offered than the operating power */
          rdo.rdo_battery.capability_mismatch = 1U;
        }
      }
      break;
    }
    case USBPD_CORE_PDO_TYPE_APDO:
    {
      if (pdo.pdo_src_spr_avs.spr_adjustable_voltage == USBPD_CORE_APDO_TYPE_SPR_AVS)
      {
      pdhandle->requested_current_1ma_units               = ma;
      dpm_params->spr_apdo                                = USBPD_SPR_APDO_AVS;
      rdo.rdo_avs.object_position                         = (uint32_t)index_src_pdo + 1U;
      rdo.rdo_avs.operating_current_50ma_units            = ma / 50;
      rdo.rdo_avs.output_voltage_25mv_units               = mv / 25;
      }
      if (pdo.pdo_src_snk_apdo.programmable_pwr_supply == USBPD_CORE_APDO_TYPE_PPS)
      {
      pdhandle->requested_current_1ma_units                = ma;
      rdo.rdo_programmable.object_position                 = (uint32_t)index_src_pdo + 1U;
      rdo.rdo_programmable.operating_current_50ma_units    = ma / 50U;
      rdo.rdo_programmable.output_voltage_20mv_units       = mv / 20U;
      }
    }
    break;
    default:
      break;
  }
  pdhandle->rdo_msg = rdo.d32;
  pdhandle->rdo_position  = rdo.rdo_generic.object_position;
  rdo_out->d32 = pdhandle->rdo_msg;
  /* Get the requested voltage */
  pdhandle->requested_voltage_1mv_units = mv;
}

