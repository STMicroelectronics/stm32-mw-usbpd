/**
  * @brief  DPM callback to allow PE to retrieve information from DPM/PWR.
  * @param  port_num The current port number.
  * @param  data_id Type of data to be updated in DPM based on @ref usbpd_core_datainfo_type_t.
  * @param  ptr Pointer on address where DPM data must be written (u8 pointer).
  * @param  size Pointer on nb of u8 written by DPM.
  */
void USBPD_DPM_GetDataInfo(uint8_t port_num, usbpd_core_datainfo_type_t data_id, uint8_t *ptr, uint32_t *size)
{
  usbpd_dpm_handle_t *h_dpm;

  h_dpm = USBPD_PWR_Get_DPM_Handler(port_num);

  if(h_dpm == NULL)
  {
    return;
  }

  /* Check type of information targeted by request */
  switch (data_id)
  {
    /* Case Port Source PDO Data information: */
    /* Case Port SINK PDO Data information: */
    case USBPD_CORE_DATAINFO_DATATYPE_SRC_PDO:
    case USBPD_CORE_DATAINFO_DATATYPE_SNK_PDO:
      USBPD_PWR_GetPortPDOs(port_num, data_id, ptr, size);
      *size *= 4U;
      break;
    case USBPD_CORE_DATAINFO_DATATYPE_REQ_VOLTAGE:       /*!< Get voltage value requested for BIST tests, expect 5V*/
      *size = 4U;
      (void)memcpy((uint8_t *)ptr, (uint8_t *)&h_dpm->requested_voltage_1mv_units, *size);
      break;
    case USBPD_CORE_DATAINFO_REVISION:
    {
      *size = sizeof(usbpd_revision_data_object_t);
      usbpd_revision_data_object_t rev =
      {
        /* Hardcoded values, user must use a global usbpd_revision_data_object_t variable */
        .b.revision_major = USBPD_REV_MAJOR,         /*!< Major revision */
        .b.revision_minor = USBPD_REV_MINOR,         /*!< Minor revision */
        .b.version_major  = USBPD_VERSION_MAJOR,     /*!< Major version  */
        .b.version_minor  = USBPD_VERSION_MINOR      /*!< Minor version  */
      };

      (void)memcpy((uint8_t *)ptr, &rev, *size);
      break;
    }
    case USBPD_CORE_DATAINFO_SNK_EXTENDED_CAPA:
    {
      *size = sizeof(usbpd_skedb_t);
      (void)memcpy((uint8_t *)ptr, (uint8_t *)&usbpd_dpm_user_settings[port_num].dpm_snk_ext_capa, *size);
      break;
    }
    case USBPD_CORE_DATAINFO_PPS_STATUS:
    {
      /* Get current drawn by sink */
      usbpd_ppsdb_t pps_status = {0U};
      *size = 4U;
      (void)memcpy((uint8_t *)ptr, (uint8_t *)&pps_status.d32, *size);
      break;
    }

    default:
      *size = 0U;
      USBPD_TRACE_INFO_PRINTF(port_num, "To be implemented: USBPD_DPM_GetDataInfo: data id = 0x%x", data_id);
      break;
  }
}

/**
  * @brief  DPM callback to allow PE to update information in DPM/PWR.
  * @param  port_num The current port number.
  * @param  data_id  Type of data to be updated in DPM based on @ref usbpd_core_datainfo_type_t
  * @param  ptr     Pointer on the data
  * @param  size    Nb of bytes to be updated in DPM
  */
void USBPD_DPM_SetDataInfo(uint8_t port_num, usbpd_core_datainfo_type_t data_id, uint8_t *ptr, uint32_t size)
{
  usbpd_dpm_handle_t *h_dpm;

  h_dpm = USBPD_PWR_Get_DPM_Handler(port_num);

  if(h_dpm == NULL)
  {
    return;
  }

  /* Check type of information targeted by request */
  switch (data_id)
  {
    /* Case Received Request PDO Data information: */
    case USBPD_CORE_DATAINFO_DATATYPE_RDO_POSITION:
      if (size == 4U)
      {
        uint8_t *temp;
        temp = (uint8_t *)&h_dpm->rdo_position;
        (void)memcpy(temp, ptr, size);
        h_dpm->rdo_position_previous = *ptr;
        temp = (uint8_t *)&h_dpm->rdo_position_previous;
        (void)memcpy(temp, ptr, size);
      }
      break;

    /* Case Received Sink PDO values Data information: */
    case USBPD_CORE_DATAINFO_DATATYPE_RCV_SNK_PDO:
      if (size <= (USBPD_MAX_NB_PDO * 4U))
      {
        uint8_t *rdo;
        h_dpm->rcv_snk_pdo_count = (size / 4U);
        /* Copy PDO data in DPM Handle field */
        for (uint32_t index = 0U; index < (size / 4U); index++)
        {
          rdo = (uint8_t *)&h_dpm->p_list_rcv_snk_pdo[index];
          (void)memcpy(rdo, (ptr + (index * 4U)), (4U * sizeof(uint8_t)));
        }
      }
      break;

    case USBPD_CORE_DATAINFO_DATATYPE_RCV_REQ_PDO:  /*!< Storage of Received Sink Request PDO value */
      if (size == 4U)
      {
        (void)memcpy((uint8_t *)&h_dpm->rcv_request_do_msg,  ptr, 4U);
      }
      break;

    /* Case Received Source PDO values Data information: */
    case USBPD_CORE_DATAINFO_DATATYPE_RCV_SRC_PDO:
      if (size <= (USBPD_MAX_NB_PDO * 4U))
      {
        uint8_t *rdo;
        h_dpm->rcv_src_pdo_count = (size / 4U);
        /* Copy PDO data in DPM Handle field */
        for (uint32_t index = 0U; index < (size / 4U); index++)
        {
          rdo = (uint8_t *)&h_dpm->p_list_rcv_src_pdo[index];
          (void)memcpy(rdo, (ptr + (index * 4U)), (4U * sizeof(uint8_t)));
        }
      }
      break;

    case USBPD_CORE_DATAINFO_PPS_STATUS:
    {
      uint8_t  *ext_capa;
      ext_capa = (uint8_t *)&h_dpm->rcv_pps_status;
      (void)memcpy(ext_capa, ptr, size);
      break;
    }

    case USBPD_CORE_DATAINFO_REVISION:
    {
      /* Does nothing: User have to implement a global revision variable */
      usbpd_revision_data_object_t rev = {0U};
      (void)memcpy((uint8_t *)&rev, ptr, sizeof(usbpd_revision_data_object_t));
      break;
    }

#if defined(USBPDCORE_SNK_CAPA_EXT)
    case USBPD_CORE_DATAINFO_SNK_EXTENDED_CAPA:
    {
      uint8_t  *_snk_ext_capa;
      _snk_ext_capa = (uint8_t *)&h_dpm->rcv_snk_extended_capa;
      (void)memcpy(_snk_ext_capa, ptr, size);
      break;
    }
#endif /* USBPDCORE_SNK_CAPA_EXT */

#if defined(USBPDCORE_BATTERY)
    case USBPD_CORE_DATAINFO_BATTERY_STATUS:
    {
      uint8_t *battery_info;
      battery_info = (uint8_t *)&h_dpm->battery_status.d32;
      memcpy(battery_info, ptr, size);
      break;
    }
#endif /* USBPDCORE_BATTERY */

    default:
      USBPD_TRACE_INFO_PRINTF(port_num, "To be implemented: USBPD_DPM_SetDataInfo: data id = 0x%x", data_id);
      break;
  }

}

/**
  * @brief  Evaluate received Request Message from Sink port.
  * @param  port_num The current port number.
  * @param  p_pwr_object Pointer on the power data object.
  * @retval USBPD status.
  */
usbpd_status_t USBPD_DPM_EvaluateRequest(uint8_t port_num, usbpd_core_pdo_type_t *p_pwr_object)
{
  usbpd_status_t ret = USBPD_REJECT;
#if defined(USBPD_DRP) || defined(USBPD_SRC)
  usbpd_pdo_t pdo;
  usbpd_rdo_snk_t rdo;
  usbpd_dpm_handle_t *h_dpm;

  h_dpm = USBPD_PWR_Get_DPM_Handler(port_num);

  if(h_dpm == NULL)
  {
    return ret;
  }

  /* read the request value received */
  rdo.d32 = h_dpm->rcv_request_do_msg;

  /* Search PDO in Port Source PDO list, that corresponds to Position provided in Request RDO */
  if (USBPD_PWR_SearchRequestedPDO(port_num,  rdo.rdo_generic.object_position, &pdo.d32) == USBPD_OK)
  {
    /* Evaluate the request */
    if ((usbpd_core_pdo_type_t)pdo.pdo_generic.pdo_type == USBPD_CORE_PDO_TYPE_FIXED)
    {
      if ((rdo.rdo_fixed_variable.operating_current_10ma_units > pdo.pdo_src_fixed.current_max_10ma_units)
          || ((rdo.rdo_fixed_variable.operating_current_max_10ma_units > pdo.pdo_src_fixed.current_max_10ma_units)
              && (rdo.rdo_fixed_variable.capability_mismatch == 0U)))
      {
        /* Sink requests too much maximum operating current */
        /* USBPD_DPM_EvaluateRequest: Sink requests too much maximum operating current */
        ret =  USBPD_REJECT;
      }
      else
      {
        /* Save the power object */
        *p_pwr_object = (usbpd_core_pdo_type_t)pdo.pdo_generic.pdo_type;

        /* Set RDO position and requested voltage in DPM port structure */
        h_dpm->requested_voltage_1mv_units = pdo.pdo_src_fixed.voltage_50mv_units * 50U;
        h_dpm->rdo_position_previous = h_dpm->rdo_position;
        h_dpm->rdo_position = rdo.rdo_generic.object_position;
        ret = USBPD_ACCEPT;
      }
    }
  }
#endif /* USBPD_DRP || USBPD_SRC */
  return ret;
}

/**
  * @brief  Evaluate received Capabilities Message from Source port and prepare the request message.
  * @param  port_num The current port number.
  * @param  p_request_data Pointer on selected request data object.
  * @param  p_pwr_object_type Pointer on the power data object.
  */
void USBPD_DPM_SNK_EvaluateCapabilities(uint8_t port_num, uint32_t *p_request_data,
                                        usbpd_core_pdo_type_t *p_pwr_object_type)
{

  usbpd_pdo_t  fixed_pdo;
  usbpd_rdo_snk_t rdo;
  usbpd_dpm_handle_t *pdhandle = USBPD_PWR_Get_DPM_Handler(port_num);
  usbpd_dpm_user_settings_t *puser = (usbpd_dpm_user_settings_t *)&usbpd_dpm_user_settings[port_num];
  usbpd_dpm_snk_pwr_request_details_t snkpowerrequestdetails;
  uint32_t pdoindex;
  uint32_t size;
  uint32_t snkpdolist[USBPD_MAX_NB_PDO];
  usbpd_pdo_t snk_fixed_pdo;

  if((puser == NULL) || (pdhandle == NULL))
  {
    return;
  }

  snkpowerrequestdetails.requested_voltage_1mv_units = 0U;
  snkpowerrequestdetails.operating_current_1ma_units = 0U;
  /* USBPD_DPM_EvaluateCapabilities: Port Partner Requests Max Voltage */

  /* Find the Pdo index for the requested voltage */
  pdoindex = DPM_FindVoltageIndex(port_num, &snkpowerrequestdetails, pdhandle->usbpd_dpm_pdo_select_method);

  /* Initialize RDO */
  rdo.d32 = 0U;

  /* If no valid SNK PDO or if no SRC PDO match found (index>=nb of valid received SRC PDOs or
     function returned DPM_NO_SRC_PDO_FOUND*/
  if (pdoindex >= pdhandle->rcv_src_pdo_count)
  {
    USBPD_TRACE_WARNING_PRINTF(port_num, "%s: Could not find desired voltage", __func__);
    fixed_pdo.d32 = pdhandle->p_list_rcv_src_pdo[0U];
    /* Read SNK PDO list for retrieving useful data to fill in RDO */
    USBPD_PWR_GetPortPDOs(port_num, USBPD_CORE_DATAINFO_DATATYPE_SNK_PDO, (uint8_t *)&snkpdolist[0U], &size);
    /* Store value of 1st SNK PDO (Fixed) in local variable */
    snk_fixed_pdo.d32 = snkpdolist[0U];
    rdo.rdo_fixed_variable.object_position = 1U;
    rdo.rdo_fixed_variable.operating_current_10ma_units  = fixed_pdo.pdo_src_fixed.current_max_10ma_units;
    rdo.rdo_fixed_variable.operating_current_max_10ma_units = fixed_pdo.pdo_src_fixed.current_max_10ma_units;
    rdo.rdo_fixed_variable.capability_mismatch = 1U;
    rdo.rdo_fixed_variable.usb_com_capable = snk_fixed_pdo.pdo_snk_fixed.usb_com_capable;
    pdhandle->requested_current_1ma_units = puser->dpm_snk_requested_pwr.operating_current_max_1ma_units;

    pdhandle->rdo_msg = rdo.d32;
    *p_pwr_object_type = USBPD_CORE_PDO_TYPE_FIXED;
    *p_request_data     = rdo.d32;
    pdhandle->requested_voltage_1mv_units = USBPD_PWR_HW_IF_VBUS_5V;
    return;
  }
  DPM_SNK_BuildRDOfromSelectedPDO(port_num, (uint8_t)pdoindex, &snkpowerrequestdetails, &rdo, p_pwr_object_type);

  *p_request_data = pdhandle->rdo_msg;
}

/**
  * @brief  Power role swap status update.
  * @param  port_num The current port number.
  * @param  current_role the current role.
  * @param  status status on power role swap event.
  */
void USBPD_DPM_PowerRoleSwap(uint8_t port_num, usbpd_port_pwr_role_t current_role, usbpd_prs_status_t status)
{
#if defined(USBPD_DRP)
  usbpd_params_t *dpm_params;

  dpm_params = USBPD_PE_Get_DPM_Params(port_num);

  if(dpm_params == NULL)
  {
    return;
  }

  switch (status)
  {
    case USBPD_PRS_STATUS_VBUS_OFF:
      if (current_role == USBPD_PORT_PWR_ROLE_SRC)
      {
        /* Avoid VConn disable during HR procedure */
        uint32_t vconnstate = dpm_params->vconn_status;
        dpm_params->vconn_status = USBPD_FALSE;

        /* In case of power role swap keep VConn On */
        (void)USBPD_PWR_DisableVBUS(port_num);

        /* Restore vconn status */
        dpm_params->vconn_status = vconnstate;
      }
      break;

    case USBPD_PRS_STATUS_SRC_RP2RD:
      USBPD_CAD_AssertRd(port_num);
      USBPD_DPM_WaitForTime(port_num, 5U);
      break;

    case USBPD_PRS_STATUS_SNK_RD2RP:
      USBPD_CAD_AssertRp(port_num);
      break;

    case USBPD_PRS_STATUS_VBUS_ON:
      (void)USBPD_PWR_EnableVBUS(port_num);
      if (USBPD_PORT_PWR_ROLE_SRC == current_role)
      {
        USBPD_DPM_WaitForTime(port_num, 20U);
      }
      break;

    default:
      break;
  }
#endif /* USBPD_DRP */
}

/**
  * @brief  Callback to be used by PE to evaluate a Vconn swap.
  * @param  port_num The current port number.
  * @retval USBPD_ACCEPT, USBPD_REJECT, USBPD_WAIT.
  */
usbpd_status_t USBPD_DPM_EvaluateVconnSwap(uint8_t port_num)
{
  usbpd_status_t status = USBPD_REJECT;
  if (USBPD_TRUE == usbpd_dpm_user_settings[port_num].pe_vconn_swap_support)
  {
    status = USBPD_ACCEPT;
  }

  return status;
}

/**
  * @brief  Callback to be used by PE to manage VConn.
  * @param  port_num The current port number.
  * @param  state Enable or Disable VConn on CC lines.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_DPM_PE_VconnPwr(uint8_t port_num, usbpd_functional_status_t state)
{
  usbpd_status_t status = USBPD_ERROR;
  usbpd_params_t *dpm_params;
  usbpd_dpm_handle_t *h_dpm;

  h_dpm = USBPD_PWR_Get_DPM_Handler(port_num);
  dpm_params = USBPD_PE_Get_DPM_Params(port_num);

  if((dpm_params == NULL) || (h_dpm == NULL))
  {
    return USBPD_ERROR;
  }

  if (CCNONE != (usbpd_cc_line_t)dpm_params->vconn_cc)
  {
    if (USBPD_ENABLE == state)
    {
      /* In case of VConn Swap SRC -> SNK. Keep information that CABLE is EMC */
      h_dpm->flag_cable_pd_capable = USBPD_TRUE;
      status = USBPD_PWR_EnableVConn(port_num, (usbpd_cc_line_t)dpm_params->vconn_cc);
    }
    else
    {
      status = USBPD_PWR_DisableVConn(port_num, (usbpd_cc_line_t)dpm_params->vconn_cc);
    }
  }

  return status;
}

