/**
  * @brief  Callback function called by PE layer when HardReset message received from PRL.
  * @param  port_num The current port number.
  * @param  current_role the current role.
  * @param  status status on hard reset event.
  */
void USBPD_DPM_HardReset(uint8_t port_num, usbpd_port_pwr_role_t current_role, usbpd_hard_reset_status_t status)
{
#if defined(USBPD_DRP) || defined(USBPD_SRC)
  usbpd_params_t *dpm_params;
  usbpd_dpm_handle_t *h_dpm;

  h_dpm = USBPD_PWR_Get_DPM_Handler(port_num);
  dpm_params = USBPD_PE_Get_DPM_Params(port_num);

  if((dpm_params == NULL) || (h_dpm == NULL))
  {
    return;
  }

  h_dpm->flag_cable_reset_ongoing = USBPD_FALSE;

  switch (status)
  {
    case USBPD_HR_STATUS_WAIT_VBUS_VSAFE0V:
      if (USBPD_PORT_PWR_ROLE_SRC == current_role)
      {
        /* Reset the power supply */
        (void)USBPD_PWR_DisableVBUS(port_num);
      }
      break;

    case USBPD_HR_STATUS_WAIT_VBUS_VSAFE5V:
      if (current_role == USBPD_PORT_PWR_ROLE_SRC)
      {
        /* When VConn is supported, the Hard Reset must cause the Port with the Rp resistor asserted to supply VConn */
        if (USBPD_TRUE == h_dpm->flag_cable_pd_capable)
        {
          dpm_params->vconn_status = USBPD_TRUE;
        }
        /* Power on the power supply */
        /* Enable the output */
        (void)USBPD_PWR_EnableVBUS(port_num);
        /* Delay for the output to be ready */
        USBPD_DPM_WaitForTime(port_num, 20U);
      }
      break;

    default:
      break;
  }
#else
  USBPD_TRACE_INFO_PRINTF(port_num, "To be implemented: USBPD_DPM_HardReset");
#endif /* USBPD_DRP || USBPD_SRC */
}

