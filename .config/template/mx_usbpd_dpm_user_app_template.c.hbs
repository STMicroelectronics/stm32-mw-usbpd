/**
  * @brief  UserCableDetection reporting events on a specified port from CAD layer.
  * @param  port_num The current port number.
  * @param  state CAD state.
  */
void USBPD_DPM_UserCableDetection(uint8_t port_num, usbpd_cad_event_t state)
{
#if defined(USBPD_DRP) || defined(USBPD_SRC)
  usbpd_params_t *dpm_params;
  usbpd_dpm_handle_t *h_dpm;

  h_dpm = USBPD_PWR_Get_DPM_Handler(port_num);
  dpm_params = USBPD_CAD_Get_DPM_Params(port_num);

  if ((h_dpm == NULL) ||(dpm_params == NULL))
  {
    return;
  }

  switch (state)
  {
    case USBPD_CAD_EVENT_ATTACHED:
    case USBPD_CAD_EVENT_ATTEMC:
    {
      h_dpm->flag_cable_pd_capable = USBPD_TRUE;
      if (dpm_params->pe_power_role == USBPD_PORT_PWR_ROLE_SRC)
      {
        (void)USBPD_PWR_EnableVBUS(port_num);
      }

      h_dpm->flag_is_connected = 1U;
      break;
    }
    case USBPD_CAD_EVENT_DETACHED:
    case USBPD_CAD_EVENT_EMC:
    default:
    {
      if (dpm_params->pe_power_role == USBPD_PORT_PWR_ROLE_SRC)
      {
        (void)USBPD_PWR_DisableVBUS(port_num);
      }
{{#unless @root.no_pd}}
      if (USBPD_TRUE == dpm_params->vconn_status)
      {
        /* Switch Off Vconn */
        (void)USBPD_DPM_PE_VconnPwr(port_num, USBPD_DISABLE);
      }
{{/unless}}
      /* Save DPM_Delay callback */
      void (*dpm_delay_callback)(uint8_t port_num, uint32_t time_ms);
      if (h_dpm != NULL)
      {
        dpm_delay_callback = h_dpm->DPM_Delay;

        /* Reset all values received from port partner */
        (void)memset(h_dpm, 0, sizeof(*h_dpm));

        /* Restore DPM_Delay callback */
        h_dpm->DPM_Delay = dpm_delay_callback;
      }
      break;
    }
  }
#else
  USBPD_TRACE_INFO_PRINTF(port_num, "To be implemented: USBPD_DPM_UserCableDetection");
#endif /* USBPD_DRP || USBPD_SRC */
}
