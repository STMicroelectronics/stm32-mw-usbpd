/**
  * @brief  DPM callback to allow PE to enter ERROR_RECOVERY state.
  * @param  port_num The current port number.
  */
void USBPD_DPM_EnterErrorRecovery(uint8_t port_num)
{
  usbpd_params_t *dpm_params;

  dpm_params = USBPD_PE_Get_DPM_Params(port_num);

  if(dpm_params == NULL)
  {
    return;
  }

  if (USBPD_TRUE == dpm_params->vconn_status)
  {
    /* Switch Off Vconn */
