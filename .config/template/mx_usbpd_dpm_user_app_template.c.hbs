{
  /* Left for the user to implement */
{{#if (eq usbpd_cxt.interfaces.port.[0].applicative.dpm.core.vendor_defined_messages true)}}
  if (USBPD_VDM_UserInit(USBPD_PORT_0) != USBPD_OK)
