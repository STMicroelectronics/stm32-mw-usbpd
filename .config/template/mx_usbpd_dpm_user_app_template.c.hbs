  * @{
  */

/**
  * @brief  Callback function called by PE to inform DPM about PE event.
  * @param  port_num The current port number.
  * @param  event_val Notification event val.
  */
void USBPD_DPM_Notification(uint8_t port_num, usbpd_notify_event_t event_val)
{
  usbpd_params_t *dpm_params;
{{#unless @root.no_pd}}
  usbpd_dpm_handle_t *h_dpm;

  h_dpm = USBPD_PWR_Get_DPM_Handler(port_num);

  if(h_dpm == NULL)
  {
    return;
  }

{{/unless}}
  dpm_params = USBPD_CAD_Get_DPM_Params(port_num);

  if(dpm_params == NULL)
  {
    return;
  }

  switch (event_val)
  {
    /**
      * Any other notification action can be managed by user by adding a new case.
      * For example, if the user want to switch on/off a LED when an explicit contract
      * is established, the user can add the following case:
      *
      * case USBPD_NOTIFY_POWER_EXPLICIT_CONTRACT:
      *  -- Switch on the LED --
      * break
      */

    /* USB related notifications */
    case USBPD_NOTIFY_USBSTACK_START:
    {
      if (USBPD_PORTDATAROLE_DFP == dpm_params->pe_data_role)
      {
{{#if (eq usbpd_cxt.core.basic.core.usb_data_support true)}}
        USBPD_USBIF_Start_DFP(port_num);
{{/if}}
      }
      else
      {
{{#if (eq usbpd_cxt.core.basic.core.usb_data_support true)}}
        USBPD_USBIF_Start_UFP(port_num);
{{/if}}
      }
      break;
    }

    case USBPD_NOTIFY_USBSTACK_STOP:
    {
      if (USBPD_PORTDATAROLE_DFP == dpm_params->pe_data_role)
      {
{{#if (eq usbpd_cxt.core.basic.core.usb_data_support true)}}
        USBPD_USBIF_Stop_DFP(port_num);
{{/if}}
      }
      else
      {
{{#if (eq usbpd_cxt.core.basic.core.usb_data_support true)}}
        USBPD_USBIF_Stop_UFP(port_num);
{{/if}}
      }
      break;
    }

    case USBPD_NOTIFY_DATAROLESWAP_DFP:
{{#if (eq usbpd_cxt.core.basic.core.usb_data_support true)}}
      USBPD_USBIF_Swap_DFP(port_num);
{{/if}}
      break;

    case USBPD_NOTIFY_DATAROLESWAP_UFP:
{{#if (eq usbpd_cxt.core.basic.core.usb_data_support true)}}
      USBPD_USBIF_Swap_UFP(port_num);
{{/if}}
      break;

    case USBPD_NOTIFY_TAMETIMEOUT:
{{#if (eq usbpd_cxt.core.basic.core.usb_data_support true)}}
      USBPD_USBIF_TAME_Timeout(port_num);
{{/if}}
      break;

    case USBPD_NOTIFY_TAMESTOP:
{{#if (eq usbpd_cxt.core.basic.core.usb_data_support true)}}
      USBPD_USBIF_TAME_Stop(port_num);
{{/if}}
      break;
{{#unless @root.no_pd}}
    case USBPD_NOTIFY_REQUEST_ACCEPTED:
    {
      /* Update the VBUS threshold according the new request */
      USBPD_PWR_UpdateVbusThreshold(port_num);

      /* Update DPM_RDOPosition only if current role is SNK */
      if (USBPD_PORT_PWR_ROLE_SNK == dpm_params->pe_power_role)
      {
        usbpd_rdo_snk_t rdo;
        rdo.d32                            = h_dpm->rdo_msg;
        h_dpm->rdo_position = rdo.rdo_generic.object_position;
      }
      break;
    }

    case USBPD_NOTIFY_POWER_SWAP_TO_SNK_DONE:
#if defined(USBPD_SNK) || defined(USBPD_DRP)
      USBPD_PWR_ResetVbusThreshold(port_num);
#endif /* USBPD_SNK || USBPD_DRP */
      break;

    case USBPD_NOTIFY_HARDRESET_RX:
#if defined(USBPD_SNK) || defined(USBPD_DRP)
      USBPD_PWR_ResetVbusThreshold(port_num);
#endif /* USBPD_SNK || USBPD_DRP */
      break;

    case USBPD_NOTIFY_HARDRESET_TX:
#if defined(USBPD_SNK) || defined(USBPD_DRP)
      USBPD_PWR_ResetVbusThreshold(port_num);
#endif /* USBPD_SNK || USBPD_DRP */
      break;

    case USBPD_NOTIFY_CABLERESET_REQUESTED:
    {
      /* CABLE_RESET is requested by the PE but port is not in the correct configuration */
      /* Only a DFP can generate Cable Reset Signaling. A DFP must only generate Cable
         Reset Signaling within an Explicit Contract. */
      if ((USBPD_PORTDATAROLE_DFP == dpm_params->pe_data_role)
          && (USBPD_FALSE == dpm_params->vconn_status))
      {
        /* DFP is not VConn source. Request a VConn Swap */
        (void)USBPD_DPM_RequestVconnSwap(port_num);
        h_dpm->flag_cable_reset_ongoing = USBPD_TRUE;
      }
      break;
    }

    case USBPD_NOTIFY_VCONN_SWAP_COMPLETE:
    {
      /* VConn Swap received in DFP. Now DFP is VConn Source --> can send the CABLE_RESET  */
      if ((USBPD_TRUE == h_dpm->flag_cable_reset_ongoing)
          && (USBPD_TRUE == dpm_params->vconn_status))
      {
        /* DFP is now VConn source. Cable Reset request could be processed */
        (void)USBPD_DPM_RequestCableReset(port_num);
        h_dpm->flag_cable_reset_ongoing = USBPD_FALSE;
      }
      break;
    }
{{else}}
{{/unless}}
    default:
      USBPD_TRACE_INFO_PRINTF(port_num, "To be implemented: USBPD_DPM_Notification() with event_val = %d", event_val);
      break;
  }
}
