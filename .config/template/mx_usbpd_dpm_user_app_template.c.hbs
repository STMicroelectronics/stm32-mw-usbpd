  }

  /* Inform CAD to enter recovery mode */
  USBPD_CAD_EnterErrorRecovery(port_num);
}

/**
  * @brief  Callback used to ask application the reply status for a data_role_swap request.
  * @param  port_num The current port number.
  * @note   if the callback is not set (ie NULL) the stack will automatically reject the request.
  * @retval Returned values are:
            @ref USBPD_ACCEPT if DRS can be accepted
            @ref USBPD_REJECT if DRS is not accepted in one data role (DFP or UFP) or in PD2.0 config
            @ref USBPD_NOTSUPPORTED if DRS is not supported at all by the application (in both data roles) - P3.0 only
  */
usbpd_status_t USBPD_DPM_EvaluateDataRoleSwap(uint8_t port_num)
{
  usbpd_status_t status = USBPD_REJECT;
  usbpd_params_t *dpm_params;

  dpm_params = USBPD_PE_Get_DPM_Params(port_num);

  if(dpm_params == NULL)
  {
    return status;
  }

  /* Sent NOT_SUPPORTED if DRS is not supported at all by the application (in both data roles) - P3.0 only */
  if ((USBPD_FALSE == usbpd_dpm_user_settings[port_num].pe_data_swap_support)
      || ((USBPD_FALSE == usbpd_dpm_user_settings[port_num].pe_dr_swap_to_dfp_support)
          && (USBPD_FALSE == usbpd_dpm_user_settings[port_num].pe_dr_swap_to_ufp_support)))
  {
    status = USBPD_NOTSUPPORTED;
  }
  else
  {
    /* ACCEPT DRS if at least supported by 1 data role */
    if (((USBPD_TRUE == usbpd_dpm_user_settings[port_num].pe_dr_swap_to_dfp_support)
         && (USBPD_PORTDATAROLE_UFP == dpm_params->pe_data_role))
        || ((USBPD_TRUE == usbpd_dpm_user_settings[port_num].pe_dr_swap_to_ufp_support)
            && (USBPD_PORTDATAROLE_DFP == dpm_params->pe_data_role)))
    {
      status = USBPD_ACCEPT;
    }
  }
  return status;
}

