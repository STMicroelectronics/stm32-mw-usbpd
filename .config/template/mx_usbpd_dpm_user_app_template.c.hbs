/**
  * @brief  Request the PE to send a request message.
  * @param  port_num     The current port number
  * @param  index_src_pdo Index on the selected SRC PDO (value between 1 to 7)
  * @param  voltage_requested Requested voltage (in MV and use mainly for APDO)
  * @retval USBPD Status
  */
usbpd_status_t USBPD_DPM_RequestMessageRequest(uint8_t port_num, uint8_t index_src_pdo, uint16_t voltage_requested)
{
  usbpd_status_t status = USBPD_ERROR;
  uint32_t voltage;
  uint32_t allowablepower;
  usbpd_rdo_snk_t rdo;
  usbpd_pdo_t  pdo;
  usbpd_core_pdo_type_t pdo_object;
  const usbpd_dpm_user_settings_t *puser = (usbpd_dpm_user_settings_t *)&usbpd_dpm_user_settings[port_num];
  usbpd_dpm_snk_pwr_request_details_t request_details;
  usbpd_dpm_handle_t *h_dpm;

  h_dpm = USBPD_PWR_Get_DPM_Handler(port_num);

  if((puser == NULL) || (h_dpm == NULL))
  {
    return status;
  }

  rdo.d32 = 0U;
  /* selected SRC PDO */
  pdo.d32 = h_dpm->p_list_rcv_src_pdo[(index_src_pdo - 1U)];
  voltage = voltage_requested;
  allowablepower = (puser->dpm_snk_requested_pwr.operating_current_max_1ma_units * voltage_requested) / 1000U;
  if (USBPD_TRUE == USBPD_DPM_SNK_EvaluateMatchWithSRCPDO(port_num, pdo.d32, &voltage, &allowablepower))
  {
    /* Check that voltage has been correctly selected */
    if (voltage_requested == voltage)
    {
      request_details.requested_voltage_1mv_units    = voltage_requested;
      request_details.operating_current_1ma_units    = (1000U * allowablepower) / voltage_requested;
      request_details.operating_current_max_1ma_units = puser->dpm_snk_requested_pwr.operating_current_max_1ma_units;
      request_details.operating_pwr_max_1mw_units   = puser->dpm_snk_requested_pwr.operating_pwr_max_1mw_units;
      request_details.operating_pwr_1mw_units      = puser->dpm_snk_requested_pwr.operating_pwr_1mw_units;
      DPM_SNK_BuildRDOfromSelectedPDO(port_num, (index_src_pdo - 1U), &request_details, &rdo, &pdo_object);
      status = USBPD_PE_Send_Request(port_num, rdo.d32, pdo_object);
    }
  }
  else
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "REQUEST not accepted by the stack");
  }
  if (USBPD_OK != status)
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "REQUEST not accepted by the stack");
  }
  return status;
}

