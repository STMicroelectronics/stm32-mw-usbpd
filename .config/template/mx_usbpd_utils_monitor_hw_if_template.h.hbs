/**
  * @brief  USBPD Monitor HW IF Status structures definition.
  */
typedef enum
{
  USBPD_MONITOR_HW_IF_OK              = 0x00000000U, /*<! Monitor HW IF operation completed successfully */
  USBPD_MONITOR_HW_IF_ERROR           = 0xFFFFFFFFU, /*<! Monitor HW IF operation completed with error   */
  USBPD_MONITOR_HW_IF_BUSY            = 0x55555555U, /*<! Monitor HW IF concurrent process ongoing       */
  USBPD_MONITOR_HW_IF_NOT_IMPLEMENTED = 0xAAAAAAAAU, /*<! Monitor HW IF operation not implemented        */
  USBPD_MONITOR_HW_IF_TIMEOUT         = 0x5A5A5A5AU  /*<! Monitor HW IF operation exceeds user timeout   */
} usbpd_monitor_hw_if_status_t;

