/**
  * @brief  Function pointer type for posting a monitor notification.
  * @param  port_num Port number.
  * @param  event_val Event value.
  */
typedef void (*usbpd_monitor_notif_post_t)(uint8_t port_num, uint16_t event_val);

/**
  * @brief  Function pointer type for formatting and sending a monitor notification.
  * @param  port_num Port number.
  * @param  notification_type Type of notification.
  * @param  value Value associated with the notification.
  * @retval Formatted notification value.
  */
typedef uint32_t (*usbpd_monitor_notif_format_send_t)(uint8_t port_num, uint32_t notification_type, uint32_t value);

/**
  * @brief  Function pointer type for saving monitor information.
  * @param  port_num Port number.
  * @param  data_id Data identifier.
  * @param  ptr Pointer to the data.
  * @param  size Size of the data.
  */
typedef void (*usbpd_monitor_save_info_t)(uint8_t port_num, uint8_t data_id, uint8_t *ptr, uint32_t size);

