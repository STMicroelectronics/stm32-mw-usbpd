/**
  * @brief  Get the voltage level on a specified port.
  * @param  port_num Port number.
  * @retval The voltage value in mV.
  */
uint32_t USBPD_PWR_HW_IF_VBUSGetVoltage(uint8_t port_num)
{
  uint32_t voltage = 0;

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    return 0;
  }
  else
  {
    return voltage;
  }
}

