/**
  * @brief  DPM main loop (OS use). Must be run in a taskwhen using an OS.
  * @return Time in ms for the OS to call back the function.
  */
uint32_t USBPD_DPM_Task(void)
{
  uint32_t timing;

  /* Run the CAD task */
  timing = USBPD_CAD_Process();

  /* Run the DPM User layer */
  USBPD_DPM_UserExecute(NULL);

  return timing;
}
{{else}}
/**
  * @brief  DPM main loop (bare-metal use). Must be run in an infinite loop.
  */
void USBPD_DPM_Run(void)
{
  static uint32_t dpm_sleep_start[USBPD_PORT_COUNT + 1]; /*!< Stores the time when the sleep mode has been entered */

  /* Run the CAD task */
  if ((HAL_GetTick() - dpm_sleep_start[USBPD_PORT_COUNT]) >= dpm_sleep_time[USBPD_PORT_COUNT])
  {
    dpm_sleep_time[USBPD_PORT_COUNT] = USBPD_CAD_Process();
    dpm_sleep_start[USBPD_PORT_COUNT] = HAL_GetTick();
  }

  /* Run the DPM User layer */
  USBPD_DPM_UserExecute(NULL);
}
