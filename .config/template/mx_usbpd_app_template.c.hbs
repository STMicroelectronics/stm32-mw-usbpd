{{#unless @root.no_pd}}
/**
  * @brief  Main task for CAD layer.
  * @param  args Not used.
  */
static void USBPD_CAD_Task(void *args)
{
  uint32_t timing;
  uint32_t event;
  TickType_t ticks;

  for (;;)
  {
    timing = USBPD_CAD_Process();

    ticks = 0;
    if (timing == 0xFFFFFFFFU)
    {
      ticks = portMAX_DELAY;
    }
    else if (timing != 0)
    {
      ticks = timing / portTICK_PERIOD_MS;
      if (ticks == 0)
      {
        ticks = 1;
      }
    }
    (void)xQueueReceive(cad_queue, &event, ticks);
  }
}
