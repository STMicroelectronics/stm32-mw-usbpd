/* Definition of Source PDOs */
uint32_t USBPD_PWR_PDO_ListSRC[USBPD_PORT_COUNT][USBPD_MAX_NB_PDO] =
{
{{#if (or (eq usbpd_cxt.interfaces.port.[0].applicative.power_role 'Source') (eq usbpd_cxt.interfaces.port.[0].applicative.power_role 'Dual Role'))}}
  {
    /* PDO 1 */
    (
      USBPD_PDO_TYPE_FIXED /* Fixed supply PDO */

      | USBPD_PDO_SRC_FIXED_SET_VOLTAGE({{usbpd_cxt.interfaces.port.[0].applicative.source_pdos.first_pdo.voltage}}U) /* Voltage in mV */
      | USBPD_PDO_SRC_FIXED_SET_MAX_CURRENT({{usbpd_cxt.interfaces.port.[0].applicative.source_pdos.first_pdo.max_current}}U) /* Max current in mA */
      | USBPD_PDO_SRC_FIXED_PEAKCURRENT_{{usbpd_cxt.interfaces.port.[0].applicative.source_pdos.first_pdo.peak_current}} /* Peak Current info */

      /* Common definitions applicable to all PDOs, defined only in PDO 1 */
{{#if usbpd_cxt.interfaces.port.[0].applicative.dpm.core.Revision_3.unchunck_mode}}
      | USBPD_PDO_SRC_FIXED_UNCHUNK_SUPPORTED /* Unchunked Extended Messages */
{{else}}
      | USBPD_PDO_SRC_FIXED_UNCHUNK_NOT_SUPPORTED /* Unchunked Extended Messages */
{{/if}}
{{#if (or (eq usbpd_cxt.interfaces.port.[0].applicative.dpm.user.data_role_swap true ) (eq usbpd_cxt.interfaces.port.[0].applicative.dpm.user.data_role_swap_dfp true) (eq usbpd_cxt.interfaces.port.[0].applicative.dpm.user.data_role_swap_ufp true))}}
      | USBPD_PDO_SRC_FIXED_DRD_SUPPORTED /* Dual-Role Data */
{{else}}
      | USBPD_PDO_SRC_FIXED_DRD_NOT_SUPPORTED /* Dual-Role Data */
{{/if}}
{{#if usbpd_cxt.interfaces.port.[0].applicative.dpm.core.Revision_3.usb_communication_capable}}
      | USBPD_PDO_SRC_FIXED_USBCOMM_SUPPORTED /* USB Communications */
{{else}}
      | USBPD_PDO_SRC_FIXED_USBCOMM_NOT_SUPPORTED /* USB Communications */
{{/if}}
{{#if usbpd_cxt.interfaces.port.[0].applicative.dpm.core.Revision_3.Unconstrained_power}}
      | USBPD_PDO_SRC_FIXED_EXT_POWER_AVAILABLE /* External Power */
{{else}}
      | USBPD_PDO_SRC_FIXED_EXT_POWER_NOT_AVAILABLE /* External Power */
{{/if}}
{{#if usbpd_cxt.interfaces.port.[0].applicative.dpm.core.Revision_3.usb_suspend}}
      | USBPD_PDO_SRC_FIXED_USBSUSPEND_SUPPORTED /* USB Suspend Supported */
{{else}}
      | USBPD_PDO_SRC_FIXED_USBSUSPEND_NOT_SUPPORTED /* USB Suspend Supported */
{{/if}}
{{#if usbpd_cxt.interfaces.port.[0].applicative.dpm.core.port_role_swap}}
      | USBPD_PDO_SRC_FIXED_DRP_SUPPORTED /* Dual-Role Power */
{{else}}
      | USBPD_PDO_SRC_FIXED_DRP_NOT_SUPPORTED /* Dual-Role Power */
{{/if}}
    ),
{{#if usbpd_cxt.interfaces.port.[0].applicative.source_pdos.pdos.[0]}}
