/** @defgroup  USBPD_VDM_USER_Exported_Types USBPD_VDM_USER Exported Types
  * @{
  */

/**
  * @brief  USBPD VDMM User Settings definition.
  */
typedef struct
{
  uint32_t                     vdm_xid_sop             : 32U; /*!< A decimal number assigned by USB-IF before
                                                                   certification                                    */
  uint32_t                     vdm_usb_vid_sop         : 16U; /*!< A unique 16-bit number, assigned to the
                                                                   vendor by USB-IF.                                */
  uint32_t                     vdm_pid_sop             : 16U; /*!< A unique number assigned by the Vendor ID holder
                                                                   identifying the product.                         */
  uint32_t                     vdm_bcd_device_sop      : 16U; /*!< A unique number assigned by the Vendor ID holder
                                                                   containing identity information relevant to the
                                                                   release version of the product.                  */
  usbpd_vdm_modal_op_support_t vdm_modal_operation     : 1U;  /*!< Product support modes                            */
  usbpd_vdm_usb_capa_t         vdm_usb_host_support    : 1U;  /*!< Indicates whether the UUT is capable of
                                                                   enumerating USB Host                             */
  usbpd_vdm_usb_capa_t         vdm_usb_device_support  : 1U;  /*!< Indicates whether the UUT is capable of
                                                                   enumerating USB Devices                          */
  usbpd_vdm_product_type_t     vdm_product_type_ufp_cp : 3U;  /*!< Product type UFP or CablePlug of the UUT         */
  usbpd_vdm_product_type_t     vdm_product_type_dfp    : 3U;  /*!< Product type DFP of the UUT                      */
  uint32_t                     reserved                : 7U;  /*!< Reserved bits                                    */
} usbpd_vdm_settings_t;

extern usbpd_vdm_settings_t  dpm_vdm_settings[USBPD_PORT_COUNT]; /*!< Exported VDM user settings */

/**
  * @}
  */

