/**
  * @brief  Inform identity callback.
  * @note   Function is called to save Identity information received in Discovery identity from port partner
            (answer to SVDM discovery identity sent by device).
  * @param  port_num Current port number.
  * @param  sop_type SOP type.
  * @param  command_status Command status.
  * @param  p_identity Pointer on the discovery identity information.
  */
static void USBPD_VDM_InformIdentity(uint8_t port_num, usbpd_sop_type_t sop_type,
                                     usbpd_vdm_user_command_type_t command_status,
                                     usbpd_vdm_discovery_identity_t *p_identity)
{
  switch (command_status)
  {
    case USBPD_VDM_COMMAND_TYPE_SVDM_RESPONDER_ACK :
      break;
    case USBPD_VDM_COMMAND_TYPE_SVDM_RESPONDER_NAK :
      break;
    case USBPD_VDM_COMMAND_TYPE_SVDM_RESPONDER_BUSY :
      break;
    default :
      break;
  }
}

