/**
  * @brief  Assign Power role of Port.
  * @param  port_num Port number.
  * @param  Role Type-C port role of type @ref usbpd_pwr_hw_if_role_t.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_SetRole(uint8_t port_num, usbpd_pwr_hw_if_role_t pwr_role)
{
  usbpd_status_t ret = USBPD_OK;

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    ret = USBPD_ERROR;
  }
  else
  {
    switch (pwr_role)
    {
      case USBPD_PWR_HW_IF_ROLE_SOURCE:
      {
        /* Set port power Role */
        USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- PWR Role Source");
        h_pwr_hw_if[port_num].pwr_role = pwr_role;

        /* Ensure that TCPP03 mode is not set to Hibernate */
        if (h_pwr_hw_if[port_num].pwr_saving_mode == USBPD_PWR_HW_IF_MODE_HIBERNATE)
        {
          if (tcpp0203_set_power_mode(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_POWER_MODE_LOWPOWER) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }
          else
          {
            h_pwr_hw_if[port_num].pwr_saving_mode = USBPD_PWR_HW_IF_MODE_LOWPOWER;
          }
        }
        break;
      }

      case USBPD_PWR_HW_IF_ROLE_SINK:
        /* Set port power role */
        USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- PWR Role Sink");
        h_pwr_hw_if[port_num].pwr_role = pwr_role;
        break;

      default:
        ret = USBPD_ERROR;
        break;
    }
  }

  return ret;
}

/**
  * @brief  Set operating mode of Port.
  * @param  port_num Port number.
  * @param  pwr_mode Type-C port power saving mode of type @ref usbpd_pwr_hw_if_mode_t.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_SetPowerMode(uint8_t port_num, usbpd_pwr_hw_if_mode_t pwr_mode)
{
  usbpd_status_t ret = USBPD_OK;
  tcpp0203_vbus_ok_flag_t flag_vbus_ok = TCPP0203_FLAG_VBUS_OK_RESET;

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    ret = USBPD_ERROR;
  }
  else
  {
    /* Evaluate requested Power config for port */
    switch (pwr_mode)
    {
      case USBPD_PWR_HW_IF_MODE_OFF:
      {
        /* Port must enter OFF mode : Reset TCPP0203 Reg0 */
        USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- PWR Mode Off");
        if (tcpp0203_reset(h_pwr_hw_if[port_num].p_tcpp0203_obj) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }
        break;
      }

      case USBPD_PWR_HW_IF_MODE_HIBERNATE:
      {
        /** Port Mode is Hibernate : (Default state at startup) suitable for SNK role
          *   - Dead Batteries Enabled,
          *   - Gate Driver Consumer controlled by I2C, Gate Driver Provider OFF
          *   - Waiting for VBUS_OK in FLGn (interrupt)
          */
        USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- PWR Mode Hibernate");
        if (tcpp0203_set_power_mode(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_POWER_MODE_HIBERNATE) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }

        /* Check if VBUS is present (in case of SNK VBUS powered device) */
        if (tcpp0203_get_vbus_ok_flag(h_pwr_hw_if[port_num].p_tcpp0203_obj, &flag_vbus_ok) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }
        if (flag_vbus_ok == TCPP0203_FLAG_VBUS_OK_SET)
        {
          if (h_pwr_hw_if[port_num].vbus_detect_cb != NULL)
          {
            /* In case of TCPP03 in Hibernate Mode (SNK config),
               Mode is set to Low power to enable TCPP03 behavior on CC lines */
            /* Switch to Low Power mode */
            USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- PWR Mode LowPower");
            if (tcpp0203_set_power_mode(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_POWER_MODE_LOWPOWER) != TCPP0203_OK)
            {
              ret = USBPD_ERROR;
            }

            /* Call VBUS detect callback */
            h_pwr_hw_if[port_num].vbus_detect_cb(port_num, USBPD_PWR_VBUS_CONNECTED);
          }
        }
        break;
      }

      case USBPD_PWR_HW_IF_MODE_LOWPOWER:
        /* Port Mode is Low Power : suitable while toggling SNK/SRC is case of DRP
          *   - Dead Batteries Disabled,
          *   - Gate Driver Consumer or Provider controlled by I2C
          *   - Waiting for VBUS_OK in FLGn (interrupt)
          */
        USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- PWR Mode LowPower");
        if (tcpp0203_set_power_mode(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_POWER_MODE_LOWPOWER) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }
        break;

      case USBPD_PWR_HW_IF_MODE_NORMAL:
        /* Port Mode is Normal : No power saving measure (Explicit contract in place) */
        USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- PWR Mode Normal");
        if (tcpp0203_set_power_mode(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_POWER_MODE_NORMAL) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }
        break;

      default:
        ret = USBPD_ERROR;
        break;
    }

    /* Save power operating mode */
    h_pwr_hw_if[port_num].pwr_saving_mode = pwr_mode;
  }
  return ret;
}

/**
  * @brief  Register USB Type-C Current callback function.
  * @note   Callback function invoked when VBUS rises above 4V (VBUS present) or
  *         when VBUS falls below programmed threshold (VBUS absent).
  * @note   Callback function is un-registered when callback function pointer
  *         argument is NULL.
  * @param  port_num Port number.
  * @param  pCallback Callback function pointer of type @ref usbpd_pwr_vbusdetect_cb_t.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_RegisterVBUSDetectCallback(uint8_t port_num,
                                                          const usbpd_pwr_vbusdetect_cb_t pCallback)
{
  usbpd_status_t ret = USBPD_OK;

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    ret = USBPD_ERROR;
  }
  else
  {
    /* Set port callback for VBUS detection event */
    h_pwr_hw_if[port_num].vbus_detect_cb = pCallback;
  }
  return ret;
}

