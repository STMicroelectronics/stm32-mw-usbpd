/** @addtogroup USBPD_PWR_HW_IF_Private_Functions USBPD_PWR_HW_IF Private Functions
  * @{
  */

/**
  * @brief  Callback function called when an event is detected on FLGn line.
  * @param  pobj  : Part object pointer.
  * @param  arg   : Optional argument given to the callback
  */
static void PWR_EventCallback(tcpp0203_obj_t *pobj, void *arg)
{
  uint8_t port_num       = 0;
  tcpp0203_vbus_ok_flag_t vbus_ok_flag   = TCPP0203_FLAG_VBUS_OK_RESET;
  tcpp0203_ovp_vbus_flag_t ovp_vbus_flag  = TCPP0203_FLAG_OVP_VBUS_RESET;
  tcpp0203_ovp_cc_flag_t ovp_cc_flag    = TCPP0203_FLAG_OVP_CC_RESET;
  tcpp0203_otp_flag_t otp_flag       = TCPP0203_FLAG_OTP_RESET;
  tcpp0203_ocp_vbus_flag_t ocp_vbus_flag  = TCPP0203_FLAG_OCP_VBUS_RESET;
  tcpp0203_ocp_vconn_flag_t ocp_vconn_flag = TCPP0203_FLAG_OCP_VCONN_RESET;
  tcpp0203_status_t status = TCPP0203_OK;

  /* Retrieve Port number from Part object pointer */
  for (uint8_t index = 0; index < (uint8_t)USBPD_PORT_COUNT; index++)
  {
    if (h_pwr_hw_if[index].p_tcpp0203_obj == pobj)
    {
      port_num = index;
      break;
    }
  }

  if (h_pwr_hw_if[port_num].p_tcpp0203_obj->pio.phi2c->global_state != HAL_I2C_STATE_IDLE)
  {
    h_pwr_hw_if[port_num].flag_pwr_event_pending = 1U;
  }
  else
  {
    /* In case of TCPP0203, this callback could be called when an event is detected
       on FLGn line */
    if (h_pwr_hw_if[port_num].flag_initialized == 1U)
    {
      /* Read flags status */
      if (tcpp0203_get_vbus_ok_flag(h_pwr_hw_if[port_num].p_tcpp0203_obj, &vbus_ok_flag) != TCPP0203_OK)
      {
        status = TCPP0203_ERROR;
      }
      if (tcpp0203_get_ovp_vbus_flag(h_pwr_hw_if[port_num].p_tcpp0203_obj, &ovp_vbus_flag) != TCPP0203_OK)
      {
        status = TCPP0203_ERROR;
      }
      if (tcpp0203_get_ovp_cc_flag(h_pwr_hw_if[port_num].p_tcpp0203_obj, &ovp_cc_flag) != TCPP0203_OK)
      {
        status = TCPP0203_ERROR;
      }
      if (tcpp0203_get_otp_flag(h_pwr_hw_if[port_num].p_tcpp0203_obj, &otp_flag) != TCPP0203_OK)
      {
        status = TCPP0203_ERROR;
      }
      if (tcpp0203_get_ocp_vbus_flag(h_pwr_hw_if[port_num].p_tcpp0203_obj, &ocp_vbus_flag) != TCPP0203_OK)
      {
        status = TCPP0203_ERROR;
      }
      if (tcpp0203_get_ocp_vconn_flag(h_pwr_hw_if[port_num].p_tcpp0203_obj, &ocp_vconn_flag) != TCPP0203_OK)
      {
        status = TCPP0203_ERROR;
      }

      if (status == TCPP0203_OK)
      {
        /* If FLGn has been set to 0 in LOW POWER or HIBERNATE mode, it is expected that a
           VBUS_OK condition is detected.
           In this case, if any, VBUS Detection callback could be called */
        switch (h_pwr_hw_if[port_num].pwr_saving_mode)
        {
          case USBPD_PWR_HW_IF_MODE_HIBERNATE:
          {
            if (vbus_ok_flag == TCPP0203_FLAG_VBUS_OK_SET)
            {
              if (h_pwr_hw_if[port_num].vbus_detect_cb != NULL)
              {
                /* In case of TCPP03 in Hibernate Mode (SNK config),
                   Mode is set to Low power to enable TCPP03 behavior on CC lines */
                /* Switch to Low Power mode */
                (void)USBPD_PWR_HW_IF_SetPowerMode(port_num, USBPD_PWR_HW_IF_MODE_LOWPOWER);
                h_pwr_hw_if[port_num].vbus_detect_cb(port_num, USBPD_PWR_VBUS_CONNECTED);
              }
            }
            else
            {
              /* In all other cases (NORMAL mode), FLGn signals fault detection events. */
              USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- Wrong detection");
            }
            break;
          }

          case USBPD_PWR_HW_IF_MODE_LOWPOWER:
          {
            if (vbus_ok_flag == TCPP0203_FLAG_VBUS_OK_SET)
            {
              if (h_pwr_hw_if[port_num].vbus_detect_cb != NULL)
              {
                h_pwr_hw_if[port_num].vbus_detect_cb(port_num, USBPD_PWR_VBUS_CONNECTED);
              }
            }
            else
            {
              /* In all other cases (NORMAL mode), FLGn signals fault detection events. */
              USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- Wrong detection");
            }
            break;
          }

          case USBPD_PWR_HW_IF_MODE_NORMAL:
          {
            uint32_t tickfault = HAL_GetTick();
            uint8_t recoveryword;

            /* In all other cases (NORMAL mode), FLGn signals fault detection events. */
            /* Check type of error raised in FLGn */
            if (ocp_vconn_flag == TCPP0203_FLAG_OCP_VCONN_SET)
            {
              USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- OCP VCONN detected");
            }
            if (ocp_vbus_flag == TCPP0203_FLAG_OCP_VBUS_SET)
            {
              USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- OCP VBUS detected");

              /* Check if detected fault could be recovered */
              /* In case of OCP fault, allow to restart and check if a 2nd OCP fault occurs in a limited time */
              if ((tickfault > h_pwr_hw_if[port_num].tick_last_fault)
                  && ((tickfault - h_pwr_hw_if[port_num].tick_last_fault) > PWR_HW_IF_FAULT_MIN_TIME_RECOVERY))
              {
                /* Send Recovery word to TCPP0203: GDC and GDP open (TCPP0203_GD_PROVIDER_SWITCH_OPEN is 0) */
                USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- Recovery procedure started");

                recoveryword = (uint8_t)TCPP0203_GD_CONSUMER_SWITCH_OPEN | (uint8_t)TCPP0203_POWER_MODE_NORMAL;
                (void)tcpp0203_write_ctrl_register(h_pwr_hw_if[port_num].p_tcpp0203_obj, &recoveryword);

                /* In case PWR Role is SRC, try to restore VBUS as soon as possible */
                if (h_pwr_hw_if[port_num].pwr_role == USBPD_PWR_HW_IF_ROLE_SOURCE)
                {
                  (void)tcpp0203_set_power_mode(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_POWER_MODE_NORMAL);
                  (void)tcpp0203_set_gate_driver_provider(h_pwr_hw_if[port_num].p_tcpp0203_obj,
                                                        TCPP0203_GD_PROVIDER_SWITCH_CLOSED);
                  USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- GDP/GDC settings: SRC (restored)");
                }
                else
                {
                  if (h_pwr_hw_if[port_num].vbus_detect_cb != NULL)
                  {
                    /* Notify Error thanks to callback */
                    h_pwr_hw_if[port_num].vbus_detect_cb(port_num, USBPD_PWR_VBUS_NOT_CONNECTED);
                  }
                }
              }
              h_pwr_hw_if[port_num].tick_last_fault = tickfault;
            }
            if (ovp_vbus_flag == TCPP0203_FLAG_OVP_VBUS_SET)
            {
              USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- OVP VBUS detected");
            }
            if (otp_flag == TCPP0203_FLAG_OTP_SET)
            {
              USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- Over temperature detected");
            }
            if (ovp_cc_flag == TCPP0203_FLAG_OVP_CC_SET)
            {
              USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- OVP CC detected");
            }
            break;
          }

          default:
          {
            /* Unexpected port state */
            USBPD_TRACE_WARNING_PRINTF(port_num, "TCPP -- Unexpected State for FLGn event");
            break;
          }
        }
      }
    }
  }
