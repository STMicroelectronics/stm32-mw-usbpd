/**
  * @brief  Initialize the PWR hardware interface.
  * @param  port_num Port number.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_Init(uint8_t port_num)
{
  usbpd_status_t ret = USBPD_OK;
  tcpp0203_tcpp_type_t tcpp_type = TCPP0203_DEVICE_TYPE_03;

  USBPD_TRACE_INFO_PRINTF(port_num, "%s", __func__);

{{#if (eq (@root.EnvVarAPI.getVariableValue 'UCPD_DBDIS') true)}}
  /* Disable STM32 dead battery as it is handled by the TCPP */
  HAL_PWR_LP_DisableUCPDDeadBattery();
{{/if}}

  if (HAL_ADC_Start(usbpd_adc_gethandle()) != HAL_OK)
  {
    return USBPD_ERROR;
  }

  if (HAL_ADC_Calibrate(usbpd_adc_gethandle()) != HAL_OK)
  {
    return USBPD_ERROR;
  }

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    ret = USBPD_ERROR;
  }
  else
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- Init");

    if (h_pwr_hw_if[port_num].flag_initialized == 0U)
    {
      /* Initialisation according to HW configuration type of port */
      switch (h_pwr_hw_if[port_num].tcpp_type)
      {
        case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02:
        case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03:
        {
          /* Set default Role to SNK */
          h_pwr_hw_if[port_num].pwr_role = USBPD_PWR_HW_IF_ROLE_SINK;

          /* Set default Power Mode to Hibernate */
          h_pwr_hw_if[port_num].pwr_saving_mode = USBPD_PWR_HW_IF_MODE_HIBERNATE;

          /* Reset port callback for VBUS detection event */
          h_pwr_hw_if[port_num].vbus_detect_cb = NULL;

          /* Reset last detected fault Tick */
          h_pwr_hw_if[port_num].tick_last_fault = 0;

          h_pwr_hw_if[port_num].p_tcpp0203_obj = (port_num == (uint8_t)USBPD_PORT_0) ? usbpd_tcpp0203_0_getobject() :
{{#if (gt usbpd_cxt.interfaces.port.length 1)}}
#if (USBPD_PORT_COUNT > 1U)
                                                 usbpd_tcpp0203_1_getobject();
#else
                                               NULL;
#endif /* (USBPD_PORT_COUNT > 1U) */
{{else}}
                                               NULL;
{{/if}}
          if (tcpp0203_init(h_pwr_hw_if[port_num].p_tcpp0203_obj, port_num) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }

          if (tcpp0203_register_cable_plugged_callback(h_pwr_hw_if[port_num].p_tcpp0203_obj,
                                                     PWR_EventCallback, NULL) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }

          if (tcpp0203_enable_it(h_pwr_hw_if[port_num].p_tcpp0203_obj)  != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }

          /* Read the component type */
          if (tcpp0203_read_tcpp_type(h_pwr_hw_if[port_num].p_tcpp0203_obj, &tcpp_type) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }
          /* Check the component type */
          else if ((tcpp_type != TCPP0203_DEVICE_TYPE_02)
                   && (tcpp_type != TCPP0203_DEVICE_TYPE_03))
          {
            ret = USBPD_ERROR;
          }
          /* Reset TCPP0203 Reg0 register */
          else if (tcpp0203_reset(h_pwr_hw_if[port_num].p_tcpp0203_obj) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }
          /* Start the TCPP0203 */
          else if (tcpp0203_start(h_pwr_hw_if[port_num].p_tcpp0203_obj) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }
          else
          {
            /* Update Port Config */
            switch (tcpp_type)
            {
              case TCPP0203_DEVICE_TYPE_02:
                h_pwr_hw_if[port_num].tcpp_type = USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02;
                USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- TCPP02 type");
                break;

              case TCPP0203_DEVICE_TYPE_03:
                h_pwr_hw_if[port_num].tcpp_type = USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03;
                USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- TCPP03 type");
                break;

              default:
                h_pwr_hw_if[port_num].tcpp_type = USBPD_PWR_HW_IF_TCPP_TYPE_NONE;
                USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- Unknown type");
                ret = USBPD_ERROR;
                break;
            }
          }
          break;
        }

        case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01:
          USBPD_TRACE_INFO_PRINTF(port_num, "TCPP01 not supported with this interface");
          break;
        case USBPD_PWR_HW_IF_TCPP_TYPE_NONE:
        default:
          USBPD_TRACE_INFO_PRINTF(port_num, "Unknown TCPP. Not supported with this interface");
          ret = USBPD_ERROR;
          break;
      }

      if (ret == USBPD_OK)
      {
        /* Set Initialisation flag */
        h_pwr_hw_if[port_num].flag_initialized = 1U;
      }
    }
  }
  return ret;
}

/**
  * @brief  De-initialize the PWR hardware interface.
  * @param  port_num Port number.
  */
void USBPD_PWR_HW_IF_DeInit(uint8_t port_num)
{
  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    return;
  }
  else
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- DeInit");

    /* Deinitialize Power config for port */
    switch (h_pwr_hw_if[port_num].tcpp_type)
    {
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03:
        (void)tcpp0203_deinit(h_pwr_hw_if[port_num].p_tcpp0203_obj);
        (void)tcpp0203_disable_it(h_pwr_hw_if[port_num].p_tcpp0203_obj);
        break;

      case USBPD_PWR_HW_IF_TCPP_TYPE_NONE:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01:
      default:
        break;
    }

    /* Reset Initialisation flag */
    h_pwr_hw_if[port_num].flag_initialized = 0U;
  }
}

/**
  * @brief  Initialize the VBUS hardware interface.
  * @param  port_num Port number.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_VBUSInit(uint8_t port_num)
{
  usbpd_status_t ret;

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    ret = USBPD_ERROR;
  }
  else
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- VBUS Init");

    /* Initialize required HW for VBUS management */
    switch (h_pwr_hw_if[port_num].tcpp_type)
    {
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03:
        /* Switch to Normal mode */
        ret = USBPD_PWR_HW_IF_SetPowerMode(port_num, USBPD_PWR_HW_IF_MODE_NORMAL);
        break;

      case USBPD_PWR_HW_IF_TCPP_TYPE_NONE:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01:
      default:
        ret = USBPD_ERROR;
        break;
    }
  }
  return ret;
}

/**
  * @brief  De-initialize the VBUS hardware interface.
  * @param  port_num Port number.
  */
void USBPD_PWR_HW_IF_VBUSDeInit(uint8_t port_num)
{
  /* Check if instance is valid */
  if (port_num < (uint8_t)USBPD_PORT_COUNT)
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- VBUS DeInit");

    /* De-Initialize required HW for VBUS management */
    switch (h_pwr_hw_if[port_num].tcpp_type)
    {
    case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02:
    {
      if (h_pwr_hw_if[port_num].pwr_role == USBPD_PWR_HW_IF_ROLE_SOURCE)
      {
        /* Switch to Low Power mode */
        (void)USBPD_PWR_HW_IF_SetPowerMode(port_num, USBPD_PWR_HW_IF_MODE_LOWPOWER);
      }
      else
      {
        /* Switch to Hibernate mode */
        (void)USBPD_PWR_HW_IF_SetPowerMode(port_num, USBPD_PWR_HW_IF_MODE_HIBERNATE);
      }
      break;
    }
    case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03:
    {
      /* Restore default gates configuration for Low power mode */
      /* => Close Gate Driver Consumer */
      if (tcpp0203_set_gate_driver_consumer(h_pwr_hw_if[port_num].p_tcpp0203_obj,
                                            TCPP0203_GD_CONSUMER_SWITCH_CLOSED) == TCPP0203_OK)
      {
        if (h_pwr_hw_if[port_num].pwr_role == USBPD_PWR_HW_IF_ROLE_SOURCE)
        {
          /* Switch to Low Power mode */
          (void)USBPD_PWR_HW_IF_SetPowerMode(port_num, USBPD_PWR_HW_IF_MODE_LOWPOWER);
        }
        else
        {
          /* Switch to Hibernate mode */
          (void)USBPD_PWR_HW_IF_SetPowerMode(port_num, USBPD_PWR_HW_IF_MODE_HIBERNATE);
        }
      }
      break;
    }
    case USBPD_PWR_HW_IF_TCPP_TYPE_NONE:
    case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01:
    default:
    break;
    }

    /* If a PWR event was triggered by interrupt during an active I2C communication with the TCPP,
    the event will be delayed and executed here */
    if (h_pwr_hw_if[port_num].flag_pwr_event_pending == 1U)
    {
      h_pwr_hw_if[port_num].flag_pwr_event_pending = 0U;
      h_pwr_hw_if[port_num].p_tcpp0203_obj->pio.phexti->p_trigger_cb(h_pwr_hw_if[port_num].p_tcpp0203_obj->pio.phexti,
                                                                     HAL_EXTI_TRIGGER_FALLING);
    }
  }
}

/**
  * @brief  Enable VBUS on a specified port.
  * @param  port_num Port number.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_EnableVBUS(uint8_t port_num)
{
  usbpd_status_t ret = USBPD_OK;

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    ret = USBPD_ERROR;
  }
  else
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- VBUS ON");

    switch (h_pwr_hw_if[port_num].tcpp_type)
    {
    case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02:
    {
      /* Port Role is now SRC : Close Gate Driver Provider */
      if (h_pwr_hw_if[port_num].pwr_role == USBPD_PWR_HW_IF_ROLE_SOURCE)
      {
        HAL_Delay(2);

        if (tcpp0203_set_gate_driver_provider(h_pwr_hw_if[port_num].p_tcpp0203_obj,
                                              TCPP0203_GD_PROVIDER_SWITCH_CLOSED) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }
      }
      else
      {
        ret = USBPD_ERROR;
      }
      break;
    }
    case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03:
    {
      /* Port Role is now SRC : Close Gate Driver Provider */
      if (h_pwr_hw_if[port_num].pwr_role == USBPD_PWR_HW_IF_ROLE_SOURCE)
      {
        if (tcpp0203_set_gate_driver_consumer(h_pwr_hw_if[port_num].p_tcpp0203_obj,
                                              TCPP0203_GD_CONSUMER_SWITCH_CLOSED) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }
        else
        {
          HAL_Delay(2);

          if (tcpp0203_set_gate_driver_provider(h_pwr_hw_if[port_num].p_tcpp0203_obj,
                                                TCPP0203_GD_PROVIDER_SWITCH_CLOSED) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }
        }
      }
      else
      {
        ret = USBPD_ERROR;
      }
      break;
    }
    case USBPD_PWR_HW_IF_TCPP_TYPE_NONE:
    case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01:
    default:
      ret = USBPD_ERROR;
      break;
    }
  }
  return ret;
}

/**
  * @brief  Disable VBUS on a specified port.
  * @param  port_num Port number.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_DisableVBUS(uint8_t port_num)
{
  usbpd_status_t ret = USBPD_OK;
  uint32_t vbus;

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    ret = USBPD_ERROR;
  }
  else
  {
    /* Open Gate driver provider */
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- VBUS OFF");
    if (tcpp0203_set_gate_driver_provider(h_pwr_hw_if[port_num].p_tcpp0203_obj,
                                        TCPP0203_GD_PROVIDER_SWITCH_OPEN) != TCPP0203_OK)
    {
      ret = USBPD_ERROR;
    }
    else
    {
      /* Set Discharge On */
      if (tcpp0203_set_vbus_discharge(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VBUS_DISCHARGE_ON) != TCPP0203_OK)
      {
        ret = USBPD_ERROR;
      }
      else
      {
        /* Wait VBUS level becomes lower than USBPD_PWR_LOW_VBUS_THRESHOLD */
        uint8_t counter = 0;

        vbus = USBPD_PWR_HW_IF_VBUSGetVoltage(port_num);

        while ((vbus >= USBPD_PWR_HW_IF_LOW_VBUS_THRESHOLD) && (counter < 20U))
        {
          counter++;
          HAL_Delay(20U);
          vbus = USBPD_PWR_HW_IF_VBUSGetVoltage(port_num);
        }

        HAL_Delay(10U);

        /* Set Discharge Off */
        if (tcpp0203_set_vbus_discharge(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VBUS_DISCHARGE_OFF) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }
      }
    }
  }
  return ret;
}

/**
  * @brief  Check if VBUS is enabled on a specified port.
  * @param  port_num Port number.
  * @retval USBPD_ENABLE if VBUS is enabled.
  * @retval USBPD_DISABLE if VBUS is disabled.
  */
usbpd_functional_status_t USBPD_PWR_HW_IF_IsEnabledVBUS(uint8_t port_num)
{
  tcpp0203_gate_driver_provider_ack_t val = TCPP0203_GD_PROVIDER_SWITCH_ACK_OPEN;

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    return USBPD_DISABLE;
  }
  else
  {
    if (tcpp0203_get_gate_driver_provider_ack(h_pwr_hw_if[port_num].p_tcpp0203_obj, &val) != TCPP0203_OK)
    {
      return USBPD_DISABLE;
    }
    else
    {
      if (val == TCPP0203_GD_PROVIDER_SWITCH_ACK_OPEN)
      {
        return USBPD_DISABLE;
      }
      else
      {
        return USBPD_ENABLE;
      }
    }
  }
}

/**
  * @brief  Initialize VConn hardware interface.
  * @param  port_num Port number.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_VConnInit(uint8_t port_num)
{
  usbpd_status_t ret = USBPD_OK;

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    ret = USBPD_ERROR;
  }
  else
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- VConn Init");

    /* Initialize required HW for VConn management */
    switch (h_pwr_hw_if[port_num].tcpp_type)
    {
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03:
      {
        /* Set VConn switch to open */
        if (tcpp0203_set_vconn_switch(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VCONN_SWITCH_OPEN) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }

        /* Set VConn discharge to off */
        if (tcpp0203_set_vconn_discharge(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VCONN_DISCHARGE_OFF) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }
        break;
      }
      case USBPD_PWR_HW_IF_TCPP_TYPE_NONE:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01:
      default:
        ret = USBPD_ERROR;
        break;
    }
  }
  return ret;
}

/**
  * @brief  De-initialize VConn hardware interface.
  * @param  port_num Port number.
  */
void USBPD_PWR_HW_IF_VConnDeInit(uint8_t port_num)
{
  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    /* Unhandled error */
  }
  else
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- VConn DeInit");

    /* Initialize required HW for VConn management */
    switch (h_pwr_hw_if[port_num].tcpp_type)
    {
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03:
      {
        /* Set VConn switch to open */
        if (tcpp0203_set_vconn_switch(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VCONN_SWITCH_OPEN) != TCPP0203_OK)
        {
          /* Unhandled error */
        }

        /* Set VConn discharge to off */
        if (tcpp0203_set_vconn_discharge(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VCONN_DISCHARGE_OFF) != TCPP0203_OK)
        {
          /* Unhandled error */
        }
        break;
      }
      case USBPD_PWR_HW_IF_TCPP_TYPE_NONE:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01:
      default:
        /* Unhandled error */
        break;
    }
  }
}

/**
  * @brief  Enable VCONN on a specified port.
  * @param  port_num Port number.
  * @param  cc_pin The CC pin.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_EnableVConn(uint8_t port_num, usbpd_cc_line_t cc_pin)
{
  usbpd_status_t ret = USBPD_OK;

  /* Check if instance is valid */
  if ((port_num >= (uint8_t)USBPD_PORT_COUNT) || ((cc_pin != CC1) && (cc_pin != CC2)))
  {
    ret = USBPD_ERROR;
  }
  else
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- VConn On - CC%d", ((cc_pin == CC1) ? 1 : 2));

    /* Initialize required HW for VConn management */
    switch (h_pwr_hw_if[port_num].tcpp_type)
    {
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03:
      {
        if (cc_pin == CC1)
        {
          if (tcpp0203_set_vconn_switch(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VCONN_SWITCH_CC1) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }
        }
        else
        {
          if (tcpp0203_set_vconn_switch(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VCONN_SWITCH_CC2) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }
        }
        break;
      }
      case USBPD_PWR_HW_IF_TCPP_TYPE_NONE:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01:
      default:
        ret = USBPD_ERROR;
        break;
    }
  }
  return ret;
}

/**
  * @brief  Disable VCONN on a specified port.
  * @param  port_num Port number.
  * @param  cc_pin The CC pin.
  * @return USBPD status of type @ref usbpd_status_t.
  */
usbpd_status_t USBPD_PWR_HW_IF_DisableVConn(uint8_t port_num, usbpd_cc_line_t cc_pin)
{
  usbpd_status_t ret = USBPD_OK;

  (void)cc_pin; /* Unused parameter */

  /* Check if instance is valid */
  if (port_num >= (uint8_t)USBPD_PORT_COUNT)
  {
    ret = USBPD_ERROR;
  }
  else
  {
    USBPD_TRACE_INFO_PRINTF(port_num, "TCPP -- VConn Off");

    /* Initialize required HW for VConn management */
    switch (h_pwr_hw_if[port_num].tcpp_type)
    {
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03:
      {
        if (tcpp0203_set_vconn_switch(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VCONN_SWITCH_OPEN) != TCPP0203_OK)
        {
          ret = USBPD_ERROR;
        }
        else
        {
          /* Discharge VCONN path */
          if (tcpp0203_set_vconn_discharge(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VCONN_DISCHARGE_ON) != TCPP0203_OK)
          {
            ret = USBPD_ERROR;
          }
          else
          {
            /* Wait DISCHARGE is completed then disable VCONN Discharge */
            HAL_Delay(10U);
            if (tcpp0203_set_vconn_discharge(h_pwr_hw_if[port_num].p_tcpp0203_obj, TCPP0203_VCONN_DISCHARGE_OFF) != TCPP0203_OK)
            {
              ret = USBPD_ERROR;
            }
          }
        }
        break;
      }
      case USBPD_PWR_HW_IF_TCPP_TYPE_NONE:
      case USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01:
      default:
        ret = USBPD_ERROR;
        break;
    }
  }
  return ret;
}

/**
  * @brief  Check if VCONN is enabled on a specified port.
  * @param  port_num Port number.
  * @param  cc_pin The CC pin.
  * @retval USBPD_ENABLE if VCONN is enabled.
  * @retval USBPD_DISABLE if VCONN is disabled.
  */
usbpd_functional_status_t USBPD_PWR_HW_IF_IsEnabledVConn(uint8_t port_num, usbpd_cc_line_t cc_pin)
{
  usbpd_functional_status_t status = USBPD_DISABLE;
  tcpp0203_vconn_switch_ack_t vconnSwitch = TCPP0203_VCONN_SWITCH_ACK_OPEN;

  /* Check if parameters are valid */
  if ((port_num >= (uint8_t)USBPD_PORT_COUNT) || ((cc_pin != CC1) && (cc_pin != CC2)))
  {
    /* Unhandled error */
  }
  else
  {
    /* Get TCPP0203 VCONN Switch position */
    if (tcpp0203_get_vconn_switch_ack(h_pwr_hw_if[port_num].p_tcpp0203_obj, &vconnSwitch) != TCPP0203_OK)
    {
      /* Unhandled error */
    }
    else
    {
      if (((cc_pin == CC1) && (vconnSwitch == TCPP0203_VCONN_SWITCH_ACK_CC1))
          || ((cc_pin == CC2) && (vconnSwitch == TCPP0203_VCONN_SWITCH_ACK_CC2))
         )
      {
        status = USBPD_ENABLE;
      }
    }
  }
  return status;
}

