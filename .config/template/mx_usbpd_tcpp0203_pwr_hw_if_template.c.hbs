/**
  * @brief  TCPP component type.
  */
typedef enum
{
  USBPD_PWR_HW_IF_TCPP_TYPE_NONE   = 0U, /*!< None or unknown TCPP type */
  USBPD_PWR_HW_IF_TCPP_TYPE_TCPP01 = 1U, /*!< TCPP01 type */
  USBPD_PWR_HW_IF_TCPP_TYPE_TCPP02 = 2U, /*!< TCPP02 type */
  USBPD_PWR_HW_IF_TCPP_TYPE_TCPP03 = 3U, /*!< TCPP03 type */
} usbpd_pwr_hw_if_tcpp_type_t;

/**
  * @brief  PWR HW IF Handle definition.
  */
typedef struct
{
  tcpp0203_obj_t              *p_tcpp0203_obj;          /*!< TCPP object                            */
  usbpd_pwr_hw_if_tcpp_type_t tcpp_type;              /*!< HW component associated to Port        */
  uint8_t                     flag_initialized;       /*!< Port Context Initialization status     */
  uint8_t                     flag_enabled;           /*!< Port IT enabled status                 */
  usbpd_pwr_hw_if_role_t      pwr_role;               /*!< Port current power role (SRC or SNK)   */
  usbpd_pwr_hw_if_mode_t      pwr_saving_mode;        /*!< Port current power saving mode         */
  uint32_t                    tick_last_fault;        /*!< Current Tick on last detected fault    */
  usbpd_pwr_vbusdetect_cb_t   vbus_detect_cb;         /*!< Port callback for VBUS detection event */
  volatile uint8_t            flag_pwr_event_pending; /*!< Flag to indicate a pending power event */
} pwr_hw_if_handle_t;

