 ****************************************************************************** -->
{{assign 'usbpd_instance' (@root.SWConfigurationAPI.getInstances  "STMicroelectronics::USB:STM32CubeMX2 Config:USBPD")~}}
{{log "usbpd_instance:" usbpd_instance}}
{{assign "USBPDFilter" (JSONparse '{"cgroup": "STM32CubeMX2 Config", "csub": "USBPD"}')~}}
{{assign 'USBPD_context' (@root.SWConfigurationAPI.getInstancesConfiguration USBPDFilter)~}}
{{assign 'usbpd_cxt' USBPD_context.[0].settings.parameters~}}
{{log "USBPD Config template usbpd_cxt:" (toJSON usbpd_cxt)~}}

<package xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.0"
  xs:noNamespaceSchemaLocation="https://github.com/Open-CMSIS-Pack/Open-CMSIS-Pack-Spec/blob/main/schema/PACK.xsd">
  {{!--Dedicated Helper that provides the PDSC PackVendor--}}
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  {{!--Dedicated Helper that provides the PDSC PackName--}}
  <name>{{@root.pdscAPI.getPackName}}</name>
  {{!--URL Tag, kept here since its required for valid schema parsing--}}
  <url>{{@root.pdscAPI.getPackURL}}</url>
  {{!--Release Section to update manually in case of new updated--}}
  <releases>
    <release version="0.0.1" date="2025-02-19">
      - First GPDSC USBPD Model Release
    </release>
  </releases>
  <conditions>
    {{~assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="usbpd lib condition, usbpd utils tracer condition,
Use TCPP01 pwr if, Use TCPP0203 pwr if, Use custom pwr if, Use usb if, Use vdm user app")}}
    {{{@root.conditions}}}
    <condition id="usbpd lib condition">
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Full')}}
      <require Cclass="USB" Cgroup="USBPD" Csub="Lib" Cvariant="USBPD_PD3FULL"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="pdo_defs"/>
      <require Cclass="USB" Cgroup="USBPD" Csub="Core timerserver"/>
      <require Cclass="USB" Cgroup="USBPD Interface" Csub="timerserver"/>
      {{/if}}
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'SPR')}}
      <require Cclass="USB" Cgroup="USBPD" Csub="Lib" Cvariant="USBPD_PD3SPR"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="pdo_defs"/>
      <require Cclass="USB" Cgroup="USBPD" Csub="Core timerserver"/>
      <require Cclass="USB" Cgroup="USBPD Interface" Csub="timerserver"/>
      {{/if}}
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Min SRC')}}
      <require Cclass="USB" Cgroup="USBPD" Csub="Lib" Cvariant="USBPD_PD3MINSRC"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="pdo_defs"/>
      <require Cclass="USB" Cgroup="USBPD" Csub="Core timerserver"/>
      <require Cclass="USB" Cgroup="USBPD Interface" Csub="timerserver"/>
      {{/if}}
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Min SNK')}}
      <require Cclass="USB" Cgroup="USBPD" Csub="Lib" Cvariant="USBPD_PD3MINSNK"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="pdo_defs"/>
      <require Cclass="USB" Cgroup="USBPD" Csub="Core timerserver"/>
      <require Cclass="USB" Cgroup="USBPD Interface" Csub="timerserver"/>
      {{/if}}
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Min DRP')}}
      <require Cclass="USB" Cgroup="USBPD" Csub="Lib" Cvariant="USBPD_PD3MINDRP"/>
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="pdo_defs"/>
      <require Cclass="USB" Cgroup="USBPD" Csub="Core timerserver"/>
      <require Cclass="USB" Cgroup="USBPD Interface" Csub="timerserver"/>
      {{/if}}
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Type C Only')}}
      <require Cclass="USB" Cgroup="USBPD" Csub="Lib" Cvariant="USBPD_PD3TYPEC"/>
      {{/if}}
    </condition>
    <condition id="usbpd utils tracer condition">
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'USE_TRACE') true)}}
      <require Cclass="USB" Cgroup="USBPD" Csub="Utils tracer"/>
      <require Cclass="USB" Cgroup="USBPD Interface" Csub="trace"/>
      {{/if}}
    </condition>
    <condition id="Use TCPP01 pwr if">
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'CHOOSE_PWR_IF') 'Tcpp01')}}
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="pwr_tcpp01_if"/>
      {{/if}}
    </condition>
    <condition id="Use TCPP0203 pwr if">
      {{#if (or (eq (@root.EnvVarAPI.getVariableValue 'CHOOSE_PWR_IF') 'Tcpp02') (eq (@root.EnvVarAPI.getVariableValue 'CHOOSE_PWR_IF') 'Tcpp03'))}}
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="pwr_tcpp0203_if"/>
      {{/if}}
    </condition>
    <condition id="Use custom pwr if">
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'CHOOSE_PWR_IF') 'Custom')}}
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="pwr_custom_if"/>
      {{/if}}
    </condition>
    <condition id="Use usb if">
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'USE_USB_IF') true)}}
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="usb_if"/>
      {{/if}}
    </condition>
    <condition id="Use vdm user app">
      {{#if (eq (@root.EnvVarAPI.getVariableValue 'USE_VDM_USER_APP') true)}}
      <require Cclass="USB" Cgroup="STM32CubeMX2 Codegen" Csub="vdm_user_app"/>
      {{/if}}
    </condition>
  </conditions>
  {{!-- This section will list all selected components with their descriptions, along with their generated files--}}
  <components>
    {{!-- This is a components data model constructed by the API, find below a snapshot for the return value--}}
   {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      {{#if (and (eq Cgroup 'Cgroup="STM32CubeMX2 Config"') (eq Csub 'Csub="USBPD"'))}}
        <Pre_Include_Global_h>
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Full')}}
#define USBPDCORE_LIB_PD3_FULL
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'SPR')}}
#define USBPDCORE_LIB_PD3_CONFIG_SPR
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Min SRC')}}
#define USBPDCORE_LIB_PD3_CONFIG_MINSRC
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Min SNK')}}
#define USBPDCORE_LIB_PD3_CONFIG_MINSNK
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Min DRP')}}
#define USBPDCORE_LIB_PD3_CONFIG_MINDRP
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_LIB') 'Type C Only')}}
#define USBPDCORE_LIB_NO_PD
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_PWR_ROLE') 'Sink')}}
#define USBPD_SNK
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_PWR_ROLE') 'Source')}}
#define USBPD_SRC
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_PWR_ROLE') 'Dual Role')}}
#define USBPD_DRP
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USE_TRACE') true)}}
#define USBPD_TRACE
{{/if}}
{{#if (eq (@root.EnvVarAPI.getVariableValue 'USBPD_TIMERSERVER') 'Timer')}}
#define USBPD_TIMERSERVER_TIM_MS
{{/if}}
#define USBPD_PORT_COUNT {{@root.usbpd_cxt.interfaces.port.length}}
        </Pre_Include_Global_h>
      {{/if}}
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>